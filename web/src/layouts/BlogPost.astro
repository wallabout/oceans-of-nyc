---
import Layout from './Layout.astro';

const { title, date, description, author } = Astro.props;
const formattedDate = new Date(date).toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---
<Layout title={`${title} — Oceans of NYC`} currentPage="blog">
  <article class="blog-post">
    <header class="post-header">
      <h1>{title}</h1>
      <div class="post-meta">
        <time datetime={date.toISOString()}>{formattedDate}</time>
        {author && <span class="post-author">by {author}</span>}
      </div>
      {description && <p class="post-description">{description}</p>}
    </header>
    <div class="post-body">
      <slot />
    </div>
    <footer class="post-footer">
      <a href="/blog" class="back-link">← Back to Blog</a>
    </footer>
  </article>
</Layout>

<style>
  .blog-post {
    max-width: 720px;
    margin: 0 auto;
    padding: 40px 20px 80px;
  }

  .post-header {
    margin-bottom: 40px;
    padding-bottom: 24px;
    border-bottom: 1px solid #e0e0e0;
  }

  .post-header h1 {
    font-size: 36px;
    font-weight: 700;
    line-height: 1.2;
    margin-bottom: 12px;
    color: #111;
  }

  .post-meta {
    display: flex;
    gap: 12px;
    align-items: center;
    font-size: 14px;
    color: #666;
    margin-bottom: 16px;
  }

  .post-author::before {
    content: '·';
    margin-right: 12px;
  }

  .post-description {
    font-size: 18px;
    color: #555;
    line-height: 1.5;
  }

  .post-body {
    font-size: 16px;
    line-height: 1.7;
    color: #333;
  }

  .post-body h2 {
    font-size: 24px;
    font-weight: 600;
    margin: 40px 0 16px;
    color: #111;
  }

  .post-body h3 {
    font-size: 20px;
    font-weight: 600;
    margin: 32px 0 12px;
    color: #111;
  }

  .post-body p {
    margin-bottom: 20px;
  }

  .post-body a {
    color: #333;
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .post-body ul,
  .post-body ol {
    margin: 0 0 20px 24px;
  }

  .post-body li {
    margin-bottom: 6px;
  }

  .post-body img {
    max-width: 100%;
    border-radius: 8px;
    margin: 24px 0;
  }

  .post-body blockquote {
    border-left: 3px solid #ddd;
    padding-left: 20px;
    color: #666;
    margin: 24px 0;
    font-style: italic;
  }

  .post-body code {
    background: #f5f5f5;
    padding: 2px 6px;
    border-radius: 3px;
    font-size: 0.9em;
    font-family: monospace;
  }

  .post-body pre {
    background: #f5f5f5;
    padding: 16px 20px;
    border-radius: 6px;
    overflow-x: auto;
    margin: 24px 0;
  }

  .post-body pre code {
    background: none;
    padding: 0;
  }

  .post-footer {
    margin-top: 60px;
    padding-top: 24px;
    border-top: 1px solid #e0e0e0;
  }

  .back-link {
    color: #666;
    text-decoration: none;
    font-size: 14px;
  }

  .back-link:hover {
    color: #333;
  }

  @media (max-width: 768px) {
    .post-header h1 {
      font-size: 28px;
    }
  }
</style>
