---
import Layout from './Layout.astro';

const { title, date, description, author } = Astro.props;
const formattedDate = new Date(date).toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---
<Layout title={`${title} — Oceans of NYC`} currentPage="blog">
  <article class="page page--narrow">
    <a href="/blog" class="back-link">← Back to Blog</a>
    <header class="page-header">
      <h1>{title}</h1>
      <p class="post-meta">
        <time datetime={date.toISOString()}>{formattedDate}</time>
        {author && <span>· by {author}</span>}
      </p>
      {description && <p class="post-description">{description}</p>}
    </header>
    <div class="post-body">
      <slot />
    </div>
  </article>
</Layout>

<style>
  .post-meta {
    font-size: 13px;
    color: #888;
    font-family: ui-monospace, "SF Mono", Menlo, monospace;
    margin-top: 4px;
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
  }

  .post-description {
    font-size: 15px;
    color: #444;
    line-height: 1.55;
    margin-top: 12px;
  }

  .post-body {
    font-size: 15px;
    line-height: 1.65;
    color: #222;
  }

  .post-body > * + * {
    margin-top: 1.2em;
  }

  .post-body h2 {
    font-size: 18px;
    font-weight: 600;
    color: #111;
    margin-top: 36px;
    margin-bottom: 8px;
    padding-top: 24px;
    border-top: 1px solid #f0f0f0;
  }

  .post-body h3 {
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    margin-top: 24px;
    margin-bottom: 4px;
    color: #666;
  }

  .post-body p {
    margin-bottom: 0;
  }

  .post-body a {
    color: #111;
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-thickness: 1px;
  }

  .post-body a:hover {
    text-decoration-thickness: 2px;
  }

  .post-body ul,
  .post-body ol {
    padding-left: 24px;
    margin: 0;
  }

  .post-body li {
    margin-bottom: 4px;
  }

  .post-body li:last-child {
    margin-bottom: 0;
  }

  .post-body img {
    max-width: 100%;
    border-radius: 6px;
    margin: 24px 0;
    display: block;
  }

  .post-body blockquote {
    border-left: 3px solid #333;
    padding: 4px 0 4px 16px;
    color: #555;
    margin: 0;
  }

  .post-body strong {
    color: #111;
    font-weight: 700;
  }

  .post-body code {
    background: #f5f5f5;
    padding: 2px 6px;
    border-radius: 4px;
    font-size: 0.875em;
    font-family: ui-monospace, "SF Mono", Menlo, monospace;
    color: #333;
  }

  .post-body pre {
    background: #f5f5f5;
    padding: 16px;
    border-radius: 6px;
    overflow-x: auto;
    margin: 0;
  }

  .post-body pre code {
    background: none;
    padding: 0;
    font-size: 0.9em;
  }
</style>
