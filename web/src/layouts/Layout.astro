---
import Nav from '../components/Nav.astro';
import '../styles/global.css';

const { title, currentPage, filterBar = false } = Astro.props;
---
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <link rel="icon" type="image/png" href="/favico/favicon-96x96.png" sizes="96x96" />
    <link rel="icon" type="image/svg+xml" href="/favico/favicon.svg" />
    <link rel="shortcut icon" href="/favico/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/favico/apple-touch-icon.png" />
    <meta name="apple-mobile-web-app-title" content="OceansOfNYC" />
    <link rel="manifest" href="/favico/site.webmanifest" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Lora:ital,wght@0,400;0,500;0,600;0,700;1,400&display=swap" />
    <title>{title}</title>
    <slot name="head" />
  </head>
  <body class:list={[{ 'has-filter-bar': filterBar }]}>
    <Nav currentPage={currentPage} />
    <slot />
    {filterBar && (
      <div class="filter-handle" id="filterHandle" aria-label="Toggle filters">
        <span class="filter-handle-label">Filters</span>
        <svg class="filter-handle-chevron" width="14" height="14" viewBox="0 0 14 14" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M2 9L7 4L12 9" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </div>
    )}
    <script is:inline>
      (function syncNavHeight() {
        const nav = document.querySelector('.nav');
        if (!nav) return;
        const update = () => {
          document.documentElement.style.setProperty('--nav-height', nav.offsetHeight + 'px');
        };
        update();
        if (typeof ResizeObserver !== 'undefined') {
          new ResizeObserver(update).observe(nav);
        } else {
          window.addEventListener('resize', update);
        }
      })();

      async function loadStats() {
        try {
          const response = await fetch('https://cdn.oceansofnyc.com/web/oceans.json', { cache: 'no-cache' });
          const data = await response.json();

          const totalSightings = data.vehicles.reduce((sum, v) => sum + (v.sightings?.length || 0), 0);
          const uniqueSighted = data.sighted.toLocaleString();
          const totalOceans = data.total.toLocaleString();
          const percentage = ((data.sighted / data.total) * 100).toFixed(1);
          const statsText = `${totalSightings.toLocaleString()} sightings | ${uniqueSighted} of ${totalOceans} (${percentage}%) Oceans found`;

          const el = document.getElementById('stats-text');
          const elMobile = document.getElementById('stats-text-mobile');
          if (el) el.textContent = statsText;
          if (elMobile) elMobile.textContent = statsText;

          return data;
        } catch (e) {
          console.error('Error loading stats:', e);
          return null;
        }
      }

      document.addEventListener('DOMContentLoaded', function () {
        loadStats();

        const filterHandle = document.getElementById('filterHandle');
        if (filterHandle) {
          filterHandle.addEventListener('click', () => {
            const filterBar = document.getElementById('filterBar');
            if (filterBar) filterBar.classList.toggle('open');
            filterHandle.classList.toggle('open');
          });
        }
      });
    </script>
  </body>
</html>
