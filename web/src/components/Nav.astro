---
const { currentPage } = Astro.props;
---
<nav class="nav">
  <a href="/" class="nav-brand">
    <img src="/oceans_of_nyc_logo.png" alt="Logo" class="nav-logo" />
    <span class="nav-title">Oceans of NYC</span>
  </a>
  <div class="nav-stats">
    <span id="stats-text"></span>
  </div>
  <div class="nav-links">
    <a href="/" class:list={['nav-link', { active: currentPage === 'index' }]}>Grid</a>
    <a href="/feed" class:list={['nav-link', { active: currentPage === 'feed' }]}>Feed</a>
    <a href="/submit" class:list={['nav-link', { active: currentPage === 'submit' }]}>Submit</a>
    <a href="/badges" class:list={['nav-link', { active: currentPage === 'badges' }]}>Badges</a>
    <!-- <a href="/missed-connections" class:list={['nav-link', { active: currentPage === 'missed-connections' }]}>Missed Connections</a> -->
    <!-- <a href="/about" class:list={['nav-link', { active: currentPage === 'about' }]}>About</a> -->
    <a href="/stats" class:list={['nav-link', { active: currentPage === 'stats' }]}>Stats</a>
    <a href="/p" class:list={['nav-link', { active: currentPage === 'pages' }]}>Pages</a>
    <a
      href="https://bsky.app/profile/oceansofnyc.com"
      class="nav-link bluesky-link"
      target="_blank"
      rel="noopener noreferrer"
      title="Join the conversation on Bluesky"
    >
      <svg width="18" height="16" viewBox="0 0 600 530" fill="currentColor" xmlns="http://www.w3.org/2000/svg">
        <path d="M135.72 44.03C202.216 93.951 273.74 195.17 300 249.49c26.262-54.316 97.782-155.54 164.28-205.46C512.26 8.009 590-19.862 590 68.825c0 17.712-10.155 148.79-16.111 170.07-20.703 73.984-96.144 92.854-163.25 81.433 117.3 19.964 147.14 86.092 82.697 152.22-122.39 125.59-175.91-31.511-189.63-71.766-2.514-7.38-3.69-10.832-3.708-7.896-.017-2.936-1.193.516-3.707 7.896-13.714 40.255-67.233 197.36-189.63 71.766-64.444-66.128-34.605-132.256 82.697-152.22-67.108 11.421-142.549-7.449-163.25-81.433C20.15 217.613 10 86.536 10 68.824c0-88.687 77.742-60.816 125.72-24.795z" />
      </svg>
    </a>
  </div>
  <div class="nav-stats mobile">
    <span id="stats-text-mobile"></span>
  </div>
</nav>
