---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Bumper Stickers — Oceans of NYC" currentPage="badges">
  <div class="page">
    <div class="page-header">
      <h1>Bumper Stickers</h1>
      <p>Badges earned by Oceans of NYC contributors.</p>
    </div>

    <div class="loading" id="loading">Loading badge data...</div>

    <div id="content" style="display: none;">
      <div class="table-wrapper">
        <table class="badges-table" id="badgesTable">
          <thead id="tableHead"></thead>
          <tbody id="tableBody"></tbody>
        </table>
      </div>
    </div>
  </div>

  <script>
    const BADGE_CATEGORIES = {
      'ocean_spotter': 'Count-Based',
      '5_club': 'Count-Based',
      '10_club': 'Count-Based',
      '25_club': 'Count-Based',
      '50_club': 'Count-Based',
      '100_club': 'Count-Based',
      '500_club': 'Count-Based',
      'sightings_benjamin': 'Count-Based',
      'oceans_century': 'Count-Based',
      'busy_week': 'Time-Based',
      'busy_month': 'Time-Based',
      'ocean_month': 'Time-Based',
      'ocean_quarter': 'Time-Based',
      'brooklyn': 'Location-Based',
      'manhattan': 'Location-Based',
      'queens': 'Location-Based',
      'bronx': 'Location-Based',
      'staten_island': 'Location-Based',
      '5_boro': 'Location-Based',
      'road_tripper': 'Location-Based',
      't5_club': 'Vehicle-Based',
      't8_club': 'Vehicle-Based',
      't_series': 'Vehicle-Based',
      'self_dupe': 'Sequence-Based',
      'seconds': 'Sequence-Based',
      'popular': 'Sequence-Based',
      'three_of_a_kind': 'Pattern-Based',
      'four_of_a_kind': 'Pattern-Based',
      'full_house': 'Pattern-Based',
      'jackpot': 'Pattern-Based',
      'short_straight': 'Pattern-Based',
      'no1boss': 'Pattern-Based',
    };

    fetch('https://cdn.oceansofnyc.com/web/oceans.json', { cache: 'no-cache' })
      .then(r => r.json())
      .then(data => {
        document.getElementById('loading').style.display = 'none';
        document.getElementById('content').style.display = 'block';

        const contributorMap = new Map();
        data.vehicles.forEach(vehicle => {
          vehicle.sightings?.forEach(sighting => {
            const name = sighting.contributor || 'Anonymous';
            if (!contributorMap.has(name)) contributorMap.set(name, { name, sighting_count: 0, badges: new Map() });
            const c = contributorMap.get(name);
            c.sighting_count++;
            sighting.badges?.forEach(b => c.badges.set(b.name, vehicle.vin));
          });
        });

        const contributors = Array.from(contributorMap.values()).sort((a, b) => b.sighting_count - a.sighting_count);
        const badges = data.badge_definitions;
        const thead = document.getElementById('tableHead');

        let headerHTML = '<tr><th class="contributor-header"></th>';
        contributors.forEach(c => {
          headerHTML += `<th class="contributor-header"><span class="contributor-name">${c.name}</span></th>`;
        });
        headerHTML += '</tr>';

        headerHTML += '<tr class="sighting-count-row"><th>Sighting Count</th>';
        contributors.forEach(c => { headerHTML += `<td>${c.sighting_count}</td>`; });
        headerHTML += '</tr>';
        thead.innerHTML = headerHTML;

        const tbody = document.getElementById('tableBody');
        let bodyHTML = '';
        let currentCategory = null;

        badges.forEach(badge => {
          const category = BADGE_CATEGORIES[badge.name] || 'Other';
          if (category !== currentCategory) {
            currentCategory = category;
            bodyHTML += `<tr class="category-row"><td colspan="${contributors.length + 1}">${category}</td></tr>`;
          }

          bodyHTML += '<tr>';
          bodyHTML += `<td><div class="badge-cell"><span class="badge-emoji">${badge.emoji || ''}</span><div class="badge-info"><span class="badge-name">${badge.display_name}</span><span class="badge-description">${badge.description}</span></div></div></td>`;
          contributors.forEach(c => {
            const vin = c.badges.get(badge.name);
            bodyHTML += `<td>${vin ? `<a href="/ocean/${vin}" class="has-badge">&#10003;</a>` : '<span class="no-badge">&mdash;</span>'}</td>`;
          });
          bodyHTML += '</tr>';
        });

        tbody.innerHTML = bodyHTML;
      })
      .catch(error => {
        document.getElementById('loading').textContent = 'Error loading data: ' + error.message;
      });
  </script>
</Layout>

<style is:global>
  .table-wrapper {
    overflow: auto;
    border: 1px solid #e0e0e0;
    border-radius: 8px;
    max-height: calc(100vh - 200px);
    background: #fff;
  }

  .badges-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 14px;
    min-width: 600px;
  }

  .badges-table th,
  .badges-table td {
    padding: 12px 16px;
    text-align: center;
    border-bottom: 1px solid #f0f0f0;
  }

  .badges-table th {
    background: #f5f5f5;
    font-weight: 600;
  }

  .badges-table thead {
    position: sticky;
    top: 0;
    z-index: 10;
  }

  .badges-table thead tr:first-child th {
    border-bottom: 1px solid #e0e0e0;
  }

  .badges-table thead tr:last-child th {
    border-bottom: 2px solid #e0e0e0;
  }

  .badges-table th:first-child,
  .badges-table td:first-child {
    text-align: left;
    position: sticky;
    left: 0;
    background: #ffffff;
    z-index: 5;
    min-width: 200px;
    border-right: 1px solid #e0e0e0;
  }

  .badges-table thead th:first-child,
  .badges-table .sighting-count-row th:first-child {
    background: #f5f5f5;
    z-index: 15;
  }

  .badges-table .sighting-count-row td:first-child {
    background: #f5f5f5;
  }

  .badges-table tbody tr:hover td {
    background: #f9f9f9;
  }

  .badges-table tbody tr:hover td:first-child {
    background: #f9f9f9;
  }

  .badge-cell {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .badge-emoji {
    font-size: 18px;
    width: 24px;
    text-align: center;
    flex-shrink: 0;
  }

  .badge-info {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 2px;
  }

  .badge-name {
    font-weight: 600;
    color: #333;
    font-size: 13px;
  }

  .badge-description {
    font-size: 12px;
    color: #888;
  }

  .contributor-header {
    height: 140px;
    vertical-align: bottom;
    padding: 8px 4px !important;
  }

  .contributor-name {
    font-weight: 600;
    white-space: nowrap;
    writing-mode: vertical-lr;
    transform: rotate(180deg);
    display: inline-block;
    font-size: 13px;
  }

  .sighting-count-row th {
    background: #f5f5f5;
    font-weight: normal;
    font-size: 12px;
    color: #666;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .sighting-count-row td {
    background: #f5f5f5;
    font-weight: 600;
    color: #333;
    font-family: ui-monospace, "SF Mono", Menlo, monospace;
  }

  .has-badge {
    color: #10b981;
    font-size: 18px;
    text-decoration: none;
  }

  a.has-badge:hover {
    color: #047857;
  }

  .no-badge {
    color: #e0e0e0;
    font-size: 14px;
  }

  .category-row td {
    background: #f0f0f0;
    font-weight: 600;
    text-align: left !important;
    color: #666;
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    padding: 8px 16px !important;
  }

  .category-row td:first-child {
    background: #f0f0f0;
  }

  .badges-page-loading {
    position: static;
    transform: none;
    text-align: center;
    padding: 40px;
    color: #666;
    font-size: 14px;
  }
</style>
