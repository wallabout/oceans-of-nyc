---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Missed Connections — Oceans of NYC" currentPage="missed-connections" filterBar={true}>
  <div class="filter-bar" id="filterBar">
    <select class="filter-select" id="mcFilterContributor">
      <option value="all">All Contributors</option>
    </select>
    <div class="mc-sort-controls">
      <span class="mc-sort-label">Sort:</span>
      <button class="mc-sort-btn mc-sort-active" data-sort="date" id="sortByDate">Date ↓</button>
      <button class="mc-sort-btn" data-sort="gap" id="sortByGap">Gap ↑</button>
    </div>
    <span class="filter-results" id="mcFilterResults"></span>
  </div>

  <main class="page mc-page">
    <div class="page-header">
      <h1>Missed Connections</h1>
      <p>Pairs of sightings of the same vehicle, spotted by different people, on the same day.</p>
    </div>

    <div class="loading" id="loading">Loading sightings...</div>

    <div id="mcCards" class="mc-cards"></div>
  </main>

  <script>
    const DATA_URL = window.location.hostname === 'localhost'
      ? '/oceans.json'
      : 'https://cdn.oceansofnyc.com/web/oceans.json';

    const escapeHTML = (s: string) =>
      String(s).replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c] ?? c));

    function getDateKey(ts: string) {
      return new Date(ts).toLocaleDateString('en-CA', { timeZone: 'America/New_York' });
    }

    function formatTime(ts: string) {
      return new Date(ts).toLocaleTimeString('en-US', {
        hour: 'numeric', minute: '2-digit', hour12: true, timeZone: 'America/New_York',
      });
    }

    function formatDate(ts: string) {
      return new Date(ts).toLocaleDateString('en-US', {
        month: 'numeric', day: 'numeric', year: '2-digit', timeZone: 'America/New_York',
      });
    }

    function gapBadgeHTML(ms: number): string {
      const totalMins = Math.round(ms / 60000);
      const hours = Math.floor(totalMins / 60);
      const mins = totalMins % 60;
      if (hours === 0) return `<span class="mc-gap-time">${mins}m</span>`;
      if (mins === 0) return `<span class="mc-gap-time">${hours}h</span>`;
      return `<span class="mc-gap-time">${hours}h</span><span class="mc-gap-time">${mins}m</span>`;
    }

    function nameHTML(s: any) {
      if (!s.contributor) return '?';
      return s.contributor_id != null
        ? `<a href="/contributor/${s.contributor_id}" class="mc-link">${escapeHTML(s.contributor)}</a>`
        : escapeHTML(s.contributor);
    }

    function photoHTML(s: any) {
      return s.image
        ? `<img src="${escapeHTML(s.image)}" alt="" class="mc-photo" loading="lazy">`
        : `<div class="mc-photo mc-photo-empty"></div>`;
    }

    function buildCard(vehicle: any, a: any, b: any, diffMs: number): HTMLElement {
      const plateText = vehicle.license_plates.map((p: any) => p.license_plate).join(', ');
      const plateLink = `<a href="/ocean/${encodeURIComponent(vehicle.vin)}" class="mc-link mc-plate-link">${escapeHTML(plateText)}</a>`;

      const isFirst = a.global_unique_sighting_index != null;
      const opOverlay = isFirst && a.ocean_points != null
        ? `<a href="/p/ocean-points" class="mc-op-overlay"><span class="mc-op-num">${a.ocean_points.toFixed(1)}</span> ◎p</a>`
        : '';
      const oceanBadge = isFirst
        ? `<div class="mc-ocean-badge"><span class="mc-first-badge">Ocean #${a.global_unique_sighting_index}</span></div>`
        : '';

      const card = document.createElement('div');
      card.className = `mc-card${isFirst ? ' mc-card-first' : ''}`;
      card.innerHTML = `
        <div class="mc-card-header">
          <span class="mc-card-date">${formatDate(a.timestamp)}</span>
          ${plateLink}
        </div>
        <div class="mc-card-body">
          <div class="mc-sighting mc-sighting-a">
            <div class="mc-photo-wrap">${photoHTML(a)}${opOverlay}</div>
            <div class="mc-sighting-info${isFirst ? ' mc-sighting-info-first' : ''}">
              ${oceanBadge}
              <div class="mc-sighting-name">by ${nameHTML(a)}</div>
              <div class="mc-sighting-meta">in ${escapeHTML(a.borough ?? '?')} at ${escapeHTML(formatTime(a.timestamp))}</div>
            </div>
          </div>
          <div class="mc-connector">
            <div class="mc-gap-badge">
              ${gapBadgeHTML(diffMs)}
              <span class="mc-gap-apart">apart</span>
            </div>
          </div>
          <div class="mc-sighting mc-sighting-b">
            <div class="mc-photo-wrap">${photoHTML(b)}</div>
            <div class="mc-sighting-info">
              <div class="mc-sighting-name">by ${nameHTML(b)}</div>
              <div class="mc-sighting-meta">in ${escapeHTML(b.borough ?? '?')} at ${escapeHTML(formatTime(b.timestamp))}</div>
            </div>
          </div>
        </div>
      `;
      return card;
    }

    type Pair = { vehicle: any; a: any; b: any; diffMs: number; card: HTMLElement };

    let allPairs: Pair[] = [];
    let sortKey: 'gap' | 'date' = 'date';
    let sortDir: 'asc' | 'desc' = 'desc';

    function applySort() {
      allPairs.sort((p, q) => {
        const diff = sortKey === 'gap'
          ? p.diffMs - q.diffMs
          : new Date(p.a.timestamp).getTime() - new Date(q.a.timestamp).getTime();
        return sortDir === 'asc' ? diff : -diff;
      });
      const container = document.getElementById('mcCards')!;
      allPairs.forEach(({ card }) => container.appendChild(card));
      updateSortButtons();
    }

    function updateSortButtons() {
      document.querySelectorAll('.mc-sort-btn').forEach((btn) => {
        const key = (btn as HTMLElement).dataset.sort as 'gap' | 'date';
        const isActive = key === sortKey;
        btn.classList.toggle('mc-sort-active', isActive);
        const arrow = isActive ? (sortDir === 'asc' ? ' ↑' : ' ↓') : (key === 'gap' ? ' ↑' : ' ↓');
        btn.textContent = (key === 'date' ? 'Date' : 'Gap') + arrow;
      });
    }

    function applyFilter() {
      const contributor = (document.getElementById('mcFilterContributor') as HTMLSelectElement).value;
      let visible = 0;
      allPairs.forEach(({ a, b, card }) => {
        const show = contributor === 'all' || a.contributor === contributor || b.contributor === contributor;
        card.style.display = show ? '' : 'none';
        if (show) visible++;
      });
      const total = allPairs.length;
      document.getElementById('mcFilterResults')!.textContent =
        visible === total ? '' : `Showing ${visible.toLocaleString()} of ${total.toLocaleString()}`;
    }

    fetch(DATA_URL)
      .then((r) => r.json())
      .then((data) => {
        document.getElementById('loading')!.style.display = 'none';

        const rawPairs: Omit<Pair, 'card'>[] = [];

        data.vehicles.forEach((vehicle: any) => {
          const sightings: any[] = vehicle.sightings ?? [];
          if (sightings.length < 2) return;

          const byDate = new Map<string, any[]>();
          sightings.forEach((s) => {
            const key = getDateKey(s.timestamp);
            if (!byDate.has(key)) byDate.set(key, []);
            byDate.get(key)!.push(s);
          });

          byDate.forEach((dayS) => {
            if (dayS.length < 2) return;
            for (let i = 0; i < dayS.length; i++) {
              for (let j = i + 1; j < dayS.length; j++) {
                const x = dayS[i], y = dayS[j];
                if (x.contributor === y.contributor) continue;
                const tX = new Date(x.timestamp).getTime();
                const tY = new Date(y.timestamp).getTime();
                const [a, b] = tX <= tY ? [x, y] : [y, x];
                rawPairs.push({ vehicle, a, b, diffMs: Math.abs(tY - tX) });
              }
            }
          });
        });

        if (rawPairs.length === 0) {
          document.getElementById('mcCards')!.innerHTML =
            '<p class="mc-empty">No missed connections yet — get out there!</p>';
          return;
        }

        // Populate contributor filter
        const contributors = new Set<string>();
        rawPairs.forEach(({ a, b }) => {
          if (a.contributor) contributors.add(a.contributor);
          if (b.contributor) contributors.add(b.contributor);
        });
        const select = document.getElementById('mcFilterContributor')!;
        Array.from(contributors).sort().forEach((c) => {
          const o = document.createElement('option');
          o.value = c; o.textContent = c;
          select.appendChild(o);
        });
        select.addEventListener('change', applyFilter);

        // Build cards
        const container = document.getElementById('mcCards')!;
        rawPairs.forEach(({ vehicle, a, b, diffMs }) => {
          const card = buildCard(vehicle, a, b, diffMs);
          allPairs.push({ vehicle, a, b, diffMs, card });
          container.appendChild(card);
        });

        // Wire up sort buttons
        document.querySelectorAll('.mc-sort-btn').forEach((btn) => {
          btn.addEventListener('click', () => {
            const key = (btn as HTMLElement).dataset.sort as 'gap' | 'date';
            if (key === sortKey) {
              sortDir = sortDir === 'asc' ? 'desc' : 'asc';
            } else {
              sortKey = key;
              sortDir = key === 'gap' ? 'asc' : 'desc';
            }
            applySort();
          });
        });

        applySort();
      })
      .catch((err) => {
        document.getElementById('loading')!.textContent = 'Error loading data: ' + err.message;
      });
  </script>
</Layout>

<style is:global>
  .mc-page {
    max-width: 1000px;
  }

  .mc-sort-controls {
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .mc-sort-label {
    font-size: 13px;
    color: var(--color-text-muted);
  }

  .mc-sort-btn {
    padding: 5px 10px;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    background: white;
    font-size: 12px;
    font-family: inherit;
    cursor: pointer;
    color: var(--color-text-muted);
    transition: all 0.15s;
  }

  .mc-sort-btn:hover {
    border-color: var(--color-text-muted);
    color: var(--color-text-body);
  }

  .mc-sort-btn.mc-sort-active {
    background: var(--color-accent);
    color: white;
    border-color: var(--color-accent);
  }

  .mc-cards {
    display: flex;
    flex-direction: column;
    gap: 16px;
    padding-bottom: 48px;
  }

  .mc-card {
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    overflow: hidden;
    background: white;
    box-shadow: 0 1px 4px rgba(0, 0, 0, 0.05);
    transition: box-shadow 0.2s;
  }

  .mc-card:hover {
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.1);
  }

  .mc-card-first {
    border-color: #0369a1;
    box-shadow: 0 0 0 1px #0369a1;
  }

  .mc-card-first:hover {
    box-shadow: 0 0 0 1px #0369a1, 0 4px 16px rgba(3, 105, 161, 0.18);
  }

  .mc-photo-wrap {
    position: relative;
    line-height: 0;
  }

  .mc-op-overlay {
    position: absolute;
    top: 12px;
    right: 12px;
    display: inline-flex;
    align-items: baseline;
    gap: 3px;
    font-size: 13px;
    font-weight: 600;
    padding: 4px 10px;
    background: rgba(224, 242, 254, 0.95);
    color: #0369a1;
    box-shadow: 0 1px 4px rgba(0, 0, 0, 0.2);
    backdrop-filter: blur(4px);
    border-radius: 6px;
    text-decoration: none;
  }

  .mc-op-num {
    font-size: 20px;
    font-weight: 700;
    line-height: 1;
  }

  .mc-first-badge {
    display: inline-block;
    background: #fef3c7;
    color: #92400e;
    font-size: 11px;
    font-weight: 600;
    padding: 2px 8px;
    border-radius: 10px;
    letter-spacing: 0.3px;
  }

  .mc-sighting-info-first {
    background: #e0f2fe;
  }

  .mc-ocean-badge {
    margin-bottom: 4px;
  }

  .mc-card-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 9px 16px;
    border-bottom: 1px solid var(--color-border-subtle);
    background: var(--color-bg-subtle);
    font-size: 12px;
  }

  .mc-card-date {
    color: var(--color-text-muted);
    font-variant-numeric: tabular-nums;
  }

  .mc-plate-link {
    font-weight: 600;
    letter-spacing: 0.5px;
    color: var(--color-text-muted);
  }

  .mc-card-body {
    display: flex;
    align-items: stretch;
  }

  .mc-sighting {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
  }

  .mc-photo {
    width: 100%;
    height: 240px;
    object-fit: cover;
    display: block;
  }

  .mc-photo-empty {
    background: var(--color-bg-muted);
    height: 240px;
  }

  .mc-sighting-info {
    padding: 14px 20px;
    text-align: center;
    font-size: 13px;
    line-height: 1.55;
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 2px;
  }

  .mc-sighting-name {
    font-weight: 600;
    color: var(--color-text);
  }

  .mc-sighting-meta {
    color: var(--color-text-muted);
    font-size: 12px;
  }

  .mc-connector {
    flex: 0 0 110px;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 20px 8px;
    border-left: 1px solid var(--color-border-subtle);
    border-right: 1px solid var(--color-border-subtle);
    background: var(--color-bg);
  }

  .mc-gap-badge {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    width: 78px;
    height: 78px;
    border-radius: 50%;
    background: #eef2ff;
    border: 2px solid var(--color-brand);
  }

  .mc-gap-time {
    font-size: 20px;
    font-weight: 700;
    color: var(--color-brand);
    line-height: 1.1;
  }

  .mc-gap-apart {
    font-size: 9px;
    font-weight: 600;
    color: var(--color-brand);
    opacity: 0.65;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    margin-top: 2px;
  }

  .mc-link {
    color: inherit;
    text-decoration: none;
    border-bottom: 1px dotted currentColor;
  }

  .mc-link:hover {
    color: var(--color-brand);
  }

  .mc-empty {
    text-align: center;
    padding: 60px 20px;
    color: var(--color-text-muted);
    font-size: 15px;
  }

  @media (max-width: 640px) {
    .mc-card-body {
      flex-direction: column;
    }

    .mc-connector {
      border-left: none;
      border-right: none;
      border-top: 1px solid var(--color-border-subtle);
      border-bottom: 1px solid var(--color-border-subtle);
      padding: 14px;
      flex: none;
    }

    .mc-photo {
      height: 200px;
    }
  }
</style>
