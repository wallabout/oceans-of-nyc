---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Stats — Oceans of NYC" currentPage="stats" filterBar={true}>
  <Fragment slot="head">
    <script is:inline src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
    <script is:inline src="https://cdn.jsdelivr.net/npm/chartjs-adapter-date-fns@3.0.0/dist/chartjs-adapter-date-fns.bundle.min.js"></script>
  </Fragment>

  <div class="filter-bar" id="filterBar">
    <select class="filter-select" id="filterContributor">
      <option value="all">All Contributors</option>
    </select>
    <select class="filter-select" id="filterBorough">
      <option value="all">All Boroughs</option>
    </select>
  </div>

  <main class="page page--medium stats-page">
    <section class="chart-section">
      <div class="chart-header">
        <h2>Sightings per <span id="sightingsUnitLabel">Day</span></h2>
        <div class="chart-toggle" id="sightingsToggle">
          <button class="toggle-btn active" data-unit="day">Day</button>
          <button class="toggle-btn" data-unit="week">Week</button>
        </div>
      </div>
      <div class="chart-container"><canvas id="sightingsPerDayChart"></canvas></div>
    </section>

    <section class="chart-section">
      <h2>Cumulative Sightings</h2>
      <div class="chart-container"><canvas id="cumulativeSightingsChart"></canvas></div>
    </section>

    <section class="chart-section">
      <div class="chart-header">
        <h2>Sighting Count Distribution</h2>
        <div class="chart-toggle" id="distributionQuickDates"></div>
      </div>
      <div class="chart-container"><canvas id="sightingCountDistributionChart"></canvas></div>
      <div class="distribution-controls">
        <button class="slider-play-btn" id="distributionPlayBtn" title="Animate through time">▶</button>
        <input type="range" id="distributionDateSlider" min="0" max="0" value="0" step="1" />
        <span class="distribution-date-label" id="distributionDateLabel"></span>
      </div>
    </section>

    <section class="chart-section">
      <div class="chart-header">
        <h2>Sighted Oceans by TLC First Report</h2>
        <div class="chart-toggle-group">
          <div class="chart-toggle" id="tlcDebutMetricToggle">
            <button class="toggle-btn active" data-metric="count">Count</button>
            <button class="toggle-btn" data-metric="share">Share</button>
          </div>
          <div class="chart-toggle" id="tlcDebutUnitToggle">
            <button class="toggle-btn" data-unit="day">Day</button>
            <button class="toggle-btn active" data-unit="week">Week</button>
            <button class="toggle-btn" data-unit="month">Month</button>
          </div>
        </div>
      </div>
      <div class="chart-container medium"><canvas id="tlcDebutChart"></canvas></div>
    </section>

    <section class="chart-section">
      <h2>First Sighting Rate vs Expected</h2>
      <div class="chart-container medium"><canvas id="firstSightingRateChart"></canvas></div>
    </section>

    <section class="chart-section">
      <h2>Ocean Points (◎p) per First Sighting <a href="/p/ocean-points" title="What are Ocean Points?" class="op-info-icon">i</a></h2>
      <div class="chart-container medium"><canvas id="oceanPointsChart"></canvas></div>
    </section>

    <section class="chart-section">
      <h2>Contributors</h2>
      <div class="chart-container"><canvas id="cumulativeContributorsChart"></canvas></div>
    </section>

    <section class="chart-section">
      <div class="chart-header">
        <h2>Unique Contributors per <span id="contributorsUnitLabel">Week</span></h2>
        <div class="chart-toggle" id="contributorsToggle">
          <button class="toggle-btn" data-unit="day">Day</button>
          <button class="toggle-btn active" data-unit="week">Week</button>
        </div>
      </div>
      <div class="chart-container"><canvas id="weeklyUniqueContributorsChart"></canvas></div>
    </section>

    <section class="chart-section">
      <div class="chart-header">
        <h2>Contributors</h2>
        <div class="chart-toggle" id="contributorsTimeToggle">
          <button class="toggle-btn active" data-period="all">All Time</button>
          <button class="toggle-btn" data-period="30">Last 30 Days</button>
          <button class="toggle-btn" data-period="7">Last 7 Days</button>
        </div>
      </div>
      <table class="stats-table" id="contributorsTable">
        <thead>
          <tr>
            <th>#</th>
            <th>Name</th>
            <th class="sortable sort-desc" data-col="totalSightings">Total Sightings</th>
            <th class="sortable" data-col="firstSightings">First Sightings</th>
            <th class="sortable" data-col="ops">◎p <a href="/p/ocean-points" title="What are Ocean Points?" class="op-info-icon">i</a></th>
            <th class="sortable" data-col="opsEfficiency" title="Ocean Point Efficiency is ◎p / sightings and gives an indication of the contributor's skill or luck in getting first sightings">◎pE</th>
            <th class="sortable" data-col="firstSightingAt">First Sighting</th>
            <th class="sortable" data-col="topBoroughPct">Top Borough</th>
          </tr>
        </thead>
        <tbody id="contributorsTbody"></tbody>
      </table>
    </section>

    <section class="chart-section">
      <h2>Sightings by Borough</h2>
      <div class="chart-container medium"><canvas id="boroughMixChart"></canvas></div>
    </section>

    <section class="chart-section">
      <h2>Top 10 Most Sighted Vehicles</h2>
      <div class="chart-container tall"><canvas id="topVehiclesChart"></canvas></div>
    </section>
  </main>

  <script>
    const CHART_COLOR = '#6b9bd1';
    const TEXT_COLOR = 'rgba(0,0,0,0.7)';
    const CHART_DEFAULTS = {
      responsive: true,
      maintainAspectRatio: false,
      plugins: { legend: { display: false } },
      scales: {
        x: { grid: { display: false }, ticks: { color: TEXT_COLOR, font: { size: 11 } }, border: { color: 'rgba(0,0,0,0.1)' } },
        y: { grid: { color: 'rgba(0,0,0,0.1)' }, ticks: { color: TEXT_COLOR, font: { size: 11 } }, border: { display: false } }
      }
    };

    function extractSightings(vehicles) {
      const sightings = [];
      for (const v of vehicles) {
        if (v.sightings?.length > 0) {
          for (const s of v.sightings) {
            sightings.push({ date: new Date(s.timestamp), contributor: s.contributor || 'Unknown', contributorId: s.contributor_id ?? null, borough: s.borough, vehicleId: v.vin, isFirstSighting: s.vehicle_sighting_index === 1, oceanPoints: s.ocean_points || 0 });
          }
        }
      }
      return sightings.sort((a, b) => a.date - b.date);
    }

function getETDateKey(date) { return date.toLocaleDateString('en-CA'); }
    function getBucketKey(date, unit) {
      if (unit === 'month') {
        return new Date(date.getFullYear(), date.getMonth(), 1).toLocaleDateString('en-CA');
      }
      if (unit === 'week') {
        const daysToMonday = (date.getDay() + 6) % 7;
        const monday = new Date(date);
        monday.setDate(date.getDate() - daysToMonday);
        return monday.toLocaleDateString('en-CA');
      }
      return getETDateKey(date);
    }

    function buildSightingsData(sightings, unit) {
      const newSightings = {}, duplicateSightings = {};
      for (const s of sightings) {
        const key = getBucketKey(s.date, unit);
        if (s.isFirstSighting) newSightings[key] = (newSightings[key] || 0) + 1;
        else duplicateSightings[key] = (duplicateSightings[key] || 0) + 1;
      }
      const sortedDates = Array.from(new Set([...Object.keys(newSightings), ...Object.keys(duplicateSightings)])).sort();
      return {
        newData: sortedDates.map(d => ({ x: new Date(d + 'T12:00:00'), y: newSightings[d] || 0 })),
        duplicateData: sortedDates.map(d => ({ x: new Date(d + 'T12:00:00'), y: duplicateSightings[d] || 0 }))
      };
    }

    function createSightingsPerDayChart(sightings) {
      const { newData, duplicateData } = buildSightingsData(sightings, 'day');
      const chart = new Chart(document.getElementById('sightingsPerDayChart'), {
        type: 'bar',
        data: { datasets: [
          { label: 'First Sightings', data: newData, backgroundColor: '#e07b53', borderRadius: { topLeft: 0, topRight: 0, bottomLeft: 2, bottomRight: 2 } },
          { label: 'Duplicate Sightings', data: duplicateData, backgroundColor: CHART_COLOR, borderRadius: { topLeft: 2, topRight: 2, bottomLeft: 0, bottomRight: 0 } }
        ]},
        options: { ...CHART_DEFAULTS, plugins: { legend: { display: true, position: 'top', labels: { color: TEXT_COLOR, usePointStyle: true, pointStyle: 'rect' } } },
          scales: { ...CHART_DEFAULTS.scales,
            x: { type: 'time', time: { unit: 'day', displayFormats: { day: 'MMM d' }, tooltipFormat: 'MMM d, yyyy' }, min: '2025-12-06', stacked: true, grid: { display: false }, ticks: { color: TEXT_COLOR, font: { size: 11 } }, border: { color: 'rgba(0,0,0,0.1)' }, title: { display: true, text: 'Date', color: TEXT_COLOR, align: 'end' } },
            y: { ...CHART_DEFAULTS.scales.y, stacked: true, title: { display: true, text: 'Sightings', color: TEXT_COLOR } }
          }
        }
      });
      return { setUnit(unit) { const { newData, duplicateData } = buildSightingsData(sightings, unit); chart.data.datasets[0].data = newData; chart.data.datasets[1].data = duplicateData; chart.options.scales.x.time.unit = unit; chart.update(); } };
    }

    function createCumulativeSightingsChart(sightings, totalVehicles) {
      const dailySightings = {}, dailyNewVehicles = {};
      for (const s of sightings) {
        const key = getETDateKey(s.date);
        dailySightings[key] = (dailySightings[key] || 0) + 1;
        if (s.isFirstSighting) dailyNewVehicles[key] = (dailyNewVehicles[key] || 0) + 1;
      }
      const sortedDates = Array.from(new Set([...Object.keys(dailySightings), ...Object.keys(dailyNewVehicles)])).sort();
      let cumulativeSightings = 0, cumulativeUnique = 0;
      const cumulativeSightingsData = [], cumulativeUniqueData = [];
      for (const d of sortedDates) {
        cumulativeSightings += dailySightings[d] || 0;
        cumulativeUnique += dailyNewVehicles[d] || 0;
        const date = new Date(d + 'T12:00:00');
        cumulativeSightingsData.push({ x: date, y: cumulativeSightings });
        cumulativeUniqueData.push({ x: date, y: cumulativeUnique });
      }
      const maxCount = Math.max(...cumulativeSightingsData.map(d => d.y));
      const maxPercent = (maxCount / totalVehicles) * 100;
      new Chart(document.getElementById('cumulativeSightingsChart'), {
        type: 'line',
        data: { datasets: [
          { label: 'Total Sightings', data: cumulativeSightingsData, borderColor: CHART_COLOR, backgroundColor: 'transparent', tension: 0.1, pointRadius: 0, yAxisID: 'y' },
          { label: 'Unique Oceans', data: cumulativeUniqueData, borderColor: '#e07b53', backgroundColor: 'transparent', tension: 0.1, pointRadius: 0, yAxisID: 'y' }
        ]},
        options: { ...CHART_DEFAULTS, plugins: { legend: { display: true, position: 'top', labels: { color: TEXT_COLOR, usePointStyle: true, pointStyle: 'line' } } },
          scales: {
            x: { type: 'time', time: { unit: 'day', displayFormats: { day: 'MMM d' }, tooltipFormat: 'MMM d, yyyy' }, min: '2025-12-06', grid: { display: false }, ticks: { color: TEXT_COLOR, font: { size: 11 } }, border: { color: 'rgba(0,0,0,0.1)' }, title: { display: true, text: 'Date', color: TEXT_COLOR, align: 'end' } },
            y: { ...CHART_DEFAULTS.scales.y, position: 'left', title: { display: true, text: 'Count', color: TEXT_COLOR } },
            y1: { ...CHART_DEFAULTS.scales.y, position: 'right', min: 0, max: maxPercent, title: { display: true, text: `% of ${totalVehicles.toLocaleString()} Oceans`, color: TEXT_COLOR }, ticks: { color: TEXT_COLOR, font: { size: 11 }, callback: value => value.toFixed(1) + '%' }, grid: { display: false } }
          }
        }
      });
    }

    function createCumulativeContributorsChart(sightings) {
      const firstContribution = {};
      for (const s of sightings) {
        const key = getETDateKey(s.date);
        if (!firstContribution[s.contributor] || key < firstContribution[s.contributor]) firstContribution[s.contributor] = key;
      }
      const dateNewContributors = {};
      for (const [, date] of Object.entries(firstContribution)) dateNewContributors[date] = (dateNewContributors[date] || 0) + 1;
      const sortedDates = Object.keys(dateNewContributors).sort();
      let cumulative = 0;
      const cumulativeData = [];
      for (const d of sortedDates) { cumulative += dateNewContributors[d]; cumulativeData.push({ x: new Date(d + 'T12:00:00'), y: cumulative }); }
      new Chart(document.getElementById('cumulativeContributorsChart'), {
        type: 'line',
        data: { datasets: [{ data: cumulativeData, borderColor: CHART_COLOR, backgroundColor: 'transparent', stepped: true, pointRadius: 0 }] },
        options: { ...CHART_DEFAULTS, scales: { ...CHART_DEFAULTS.scales,
          x: { type: 'time', time: { unit: 'day', displayFormats: { day: 'MMM d' }, tooltipFormat: 'MMM d, yyyy' }, min: '2025-12-06', grid: { display: false }, ticks: { color: TEXT_COLOR, font: { size: 11 } }, border: { color: 'rgba(0,0,0,0.1)' }, title: { display: true, text: 'Date', color: TEXT_COLOR, align: 'end' } },
          y: { ...CHART_DEFAULTS.scales.y, title: { display: true, text: 'Cumulative Contributors', color: TEXT_COLOR } }
        }}
      });
    }

    function buildUniqueContributorsData(sightings, unit) {
      const buckets = {};
      for (const s of sightings) { const key = getBucketKey(s.date, unit); if (!buckets[key]) buckets[key] = new Set(); buckets[key].add(s.contributor); }
      return Object.keys(buckets).sort().map(k => ({ x: new Date(k + 'T12:00:00'), y: buckets[k].size }));
    }

    function createWeeklyUniqueContributorsChart(sightings) {
      const chart = new Chart(document.getElementById('weeklyUniqueContributorsChart'), {
        type: 'bar',
        data: { datasets: [{ data: buildUniqueContributorsData(sightings, 'week'), backgroundColor: CHART_COLOR, borderRadius: 2 }] },
        options: { ...CHART_DEFAULTS, scales: {
          x: { type: 'time', time: { unit: 'week', isoWeekday: true, displayFormats: { day: 'MMM d', week: 'MMM d' }, tooltipFormat: 'MMM d, yyyy' }, min: '2025-12-06', grid: { display: false }, ticks: { color: TEXT_COLOR, font: { size: 11 } }, border: { color: 'rgba(0,0,0,0.1)' }, title: { display: true, text: 'Week', color: TEXT_COLOR, align: 'end' } },
          y: { ...CHART_DEFAULTS.scales.y, title: { display: true, text: 'Unique Contributors', color: TEXT_COLOR } }
        }}
      });
      return { setUnit(unit) { chart.data.datasets[0].data = buildUniqueContributorsData(sightings, unit); chart.options.scales.x.time.unit = unit; chart.options.scales.x.title.text = unit === 'week' ? 'Week' : 'Date'; chart.update(); } };
    }

    let contributorsSortCol = 'totalSightings';
    let contributorsSortDir = 'desc';
    let currentContributorRows = [];
    let contributorsTimePeriod = 'all';

    function filterByPeriod(sightings: any[], period: string) {
      if (period === 'all') return sightings;
      const cutoff = new Date();
      cutoff.setDate(cutoff.getDate() - parseInt(period));
      return sightings.filter((s: any) => s.date >= cutoff);
    }

    function renderContributorRows() {
      const sorted = [...currentContributorRows].sort((a, b) => {
        const diff = b[contributorsSortCol] - a[contributorsSortCol];
        return contributorsSortDir === 'desc' ? diff : -diff;
      });
      const escapeHTML = s => String(s).replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
      const maxOps = Math.max(...currentContributorRows.map(r => r.ops), 0);
      const maxOpsEff = Math.max(...currentContributorRows.map(r => r.opsEfficiency), 0);
      const maxFirst = Math.max(...currentContributorRows.map(r => r.firstSightings), 0);
      const maxTotal = Math.max(...currentContributorRows.map(r => r.totalSightings), 0);
      const tbody = document.getElementById('contributorsTbody');
      if (!tbody) return;
      tbody.innerHTML = '';
      sorted.forEach((c, i) => {
        const tr = document.createElement('tr');
        const opsPct = maxOps ? (c.ops / maxOps * 100).toFixed(1) : '0';
        const opsEffPct = maxOpsEff ? (c.opsEfficiency / maxOpsEff * 100).toFixed(1) : '0';
        const firstPct = maxFirst ? (c.firstSightings / maxFirst * 100).toFixed(1) : '0';
        const totalPct = maxTotal ? (c.totalSightings / maxTotal * 100).toFixed(1) : '0';
        const firstSightingDate = c.firstSightingAt.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
        const nameCell = c.contributorId != null
          ? `<a class="contributor-link" href="/contributor/${c.contributorId}">${escapeHTML(c.name)}</a>`
          : escapeHTML(c.name);
        const topBoroughCell = c.topBorough
          ? `${escapeHTML(c.topBorough)} <span class="top-borough-pct">${c.topBoroughPct.toFixed(0)}%</span>`
          : '—';
        tr.innerHTML = `<td>${i + 1}</td><td>${nameCell}</td><td class="bar-cell" style="--pct:${totalPct}%">${c.totalSightings.toLocaleString()}</td><td class="bar-cell" style="--pct:${firstPct}%">${c.firstSightings.toLocaleString()}</td><td class="bar-cell" style="--pct:${opsPct}%">${c.ops.toFixed(1)}</td><td class="bar-cell" style="--pct:${opsEffPct}%">${c.opsEfficiency.toFixed(2)}</td><td>${firstSightingDate}</td><td>${topBoroughCell}</td>`;
        tbody.appendChild(tr);
      });
      document.querySelectorAll('#contributorsTable .sortable').forEach(th => {
        const active = th.dataset.col === contributorsSortCol;
        th.classList.toggle('sort-asc', active && contributorsSortDir === 'asc');
        th.classList.toggle('sort-desc', active && contributorsSortDir === 'desc');
      });
    }

    function createContributorsTable(sightings) {
      const byContributor = {};
      for (const s of sightings) {
        if (!byContributor[s.contributor]) byContributor[s.contributor] = { name: s.contributor, contributorId: s.contributorId, firstSightingAt: s.date, ops: 0, opsEfficiency: 0, firstSightings: 0, totalSightings: 0, boroughCounts: {} };
        const c = byContributor[s.contributor];
        if (s.date < c.firstSightingAt) c.firstSightingAt = s.date;
        c.ops += s.oceanPoints;
        if (s.isFirstSighting) c.firstSightings++;
        c.totalSightings++;
        const borough = s.borough || 'Unknown';
        c.boroughCounts[borough] = (c.boroughCounts[borough] || 0) + 1;
      }
      for (const c of Object.values(byContributor) as any[]) {
        let topBorough = null, topCount = 0;
        for (const [b, count] of Object.entries(c.boroughCounts)) {
          if (count > topCount) { topCount = count; topBorough = b; }
        }
        c.topBorough = topBorough;
        c.topBoroughPct = c.totalSightings > 0 ? (topCount / c.totalSightings) * 100 : 0;
        c.opsEfficiency = c.totalSightings > 0 ? c.ops / c.totalSightings : 0;
      }
      currentContributorRows = Object.values(byContributor);
      renderContributorRows();

      const table = document.getElementById('contributorsTable');
      if (table && !table.dataset.listenersAdded) {
        table.dataset.listenersAdded = '1';
        table.querySelectorAll('.sortable').forEach(th => {
          th.addEventListener('click', () => {
            const col = th.dataset.col;
            if (col === contributorsSortCol) {
              contributorsSortDir = contributorsSortDir === 'desc' ? 'asc' : 'desc';
            } else {
              contributorsSortCol = col;
              contributorsSortDir = 'desc';
            }
            renderContributorRows();
          });
        });
      }
    }

    const BOROUGH_COLORS = { 'Manhattan': '#5ab5a0', 'Brooklyn': '#d4845a', 'Queens': '#8b7ec8', 'Bronx': '#c75b7a', 'Staten Island': '#a8b035' };

    function createBoroughMixChart(sightings: any[]) {
      const weekBoroughCounts: Record<string, Record<string, number>> = {};
      const knownBoroughs = new Set(Object.keys(BOROUGH_COLORS));
      for (const s of sightings) {
        if (!knownBoroughs.has(s.borough)) continue;
        const key = getBucketKey(s.date, 'week');
        if (!weekBoroughCounts[key]) weekBoroughCounts[key] = {};
        weekBoroughCounts[key][s.borough] = (weekBoroughCounts[key][s.borough] || 0) + 1;
      }
      const weeks = Object.keys(weekBoroughCounts).sort();
      const boroughSet = new Set<string>();
      for (const week of weeks) for (const b of Object.keys(weekBoroughCounts[week])) boroughSet.add(b);
      const BC = BOROUGH_COLORS as Record<string, string>;
      const boroughs = Object.keys(BOROUGH_COLORS).filter(b => boroughSet.has(b));
      const datasets = boroughs.map(borough => ({
        label: borough,
        data: weeks.map(week => {
          const counts = weekBoroughCounts[week];
          const total = Object.values(counts).reduce((s, v) => s + v, 0);
          return { x: new Date(week + 'T12:00:00'), y: total > 0 ? ((counts[borough] || 0) / total) * 100 : 0 };
        }),
        backgroundColor: BC[borough] || '#999',
        borderColor: 'transparent',
        fill: true,
        tension: 0.3,
        pointRadius: 0,
      }));
      new Chart(document.getElementById('boroughMixChart'), {
        type: 'line',
        data: { datasets },
        options: { ...CHART_DEFAULTS,
          plugins: { legend: { display: true, position: 'top', labels: { color: TEXT_COLOR, usePointStyle: true, pointStyle: 'rect' } } },
          scales: {
            x: { type: 'time', time: { unit: 'week', isoWeekday: true, displayFormats: { week: 'MMM d' }, tooltipFormat: 'MMM d, yyyy' }, min: '2025-12-06', grid: { display: false }, ticks: { color: TEXT_COLOR, font: { size: 11 } }, border: { color: 'rgba(0,0,0,0.1)' }, title: { display: true, text: 'Week', color: TEXT_COLOR, align: 'end' } },
            y: { stacked: true, min: 0, max: 100, grid: { color: 'rgba(0,0,0,0.1)' }, ticks: { color: TEXT_COLOR, font: { size: 11 }, callback: (v: number | string) => Number(v).toFixed(0) + '%' }, border: { display: false }, title: { display: true, text: '% of Sightings', color: TEXT_COLOR } }
          }
        }
      });
    }

    function createTopVehiclesChart(sightings) {
      const vehicleBoroughCounts = {}, vehicleTotals = {};
      for (const s of sightings) {
        const id = s.vehicleId, borough = s.borough || 'Unknown';
        if (!vehicleBoroughCounts[id]) vehicleBoroughCounts[id] = {};
        vehicleBoroughCounts[id][borough] = (vehicleBoroughCounts[id][borough] || 0) + 1;
        vehicleTotals[id] = (vehicleTotals[id] || 0) + 1;
      }
      const top10 = Object.entries(vehicleTotals).sort((a, b) => b[1] - a[1]).slice(0, 10).map(([id]) => id);
      const vehiclePlates = {};
      for (const v of allVehiclesData) { if (top10.includes(v.vin)) vehiclePlates[v.vin] = v.license_plates?.[0]?.license_plate || v.vin; }
      const boroughSet = new Set();
      for (const id of top10) for (const b of Object.keys(vehicleBoroughCounts[id])) boroughSet.add(b);
      const boroughs = Array.from(boroughSet).sort();
      new Chart(document.getElementById('topVehiclesChart'), {
        type: 'bar',
        data: { labels: top10.map(id => vehiclePlates[id] || id), datasets: boroughs.map(borough => ({ label: borough, data: top10.map(id => vehicleBoroughCounts[id][borough] || 0), backgroundColor: BOROUGH_COLORS[borough] || '#999', borderRadius: 2 })) },
        options: { ...CHART_DEFAULTS, indexAxis: 'y', plugins: { legend: { display: true, position: 'top', labels: { color: TEXT_COLOR, usePointStyle: true, pointStyle: 'rect' } } },
          scales: { x: { ...CHART_DEFAULTS.scales.x, stacked: true, title: { display: true, text: 'Sightings Count', color: TEXT_COLOR, align: 'end' } }, y: { ...CHART_DEFAULTS.scales.y, stacked: true, grid: { display: false } } }
        }
      });
    }

    function createOceanPointsChart(sightings) {
      const data = sightings
        .filter(s => s.isFirstSighting && s.oceanPoints > 0)
        .map(s => ({ x: s.date, y: s.oceanPoints }));
      new Chart(document.getElementById('oceanPointsChart'), {
        type: 'line',
        data: { datasets: [{ label: 'Ocean Points', data, borderColor: CHART_COLOR, backgroundColor: 'transparent', tension: 0.1, pointRadius: 0 }] },
        options: { ...CHART_DEFAULTS,
          scales: {
            x: { type: 'time', time: { unit: 'day', displayFormats: { day: 'MMM d' }, tooltipFormat: 'MMM d, yyyy' }, min: '2025-12-06', grid: { display: false }, ticks: { color: TEXT_COLOR, font: { size: 11 } }, border: { color: 'rgba(0,0,0,0.1)' }, title: { display: true, text: 'Date', color: TEXT_COLOR, align: 'end' } },
            y: { ...CHART_DEFAULTS.scales.y, min: 0, title: { display: true, text: '◎p', color: TEXT_COLOR } }
          }
        }
      });
    }

    function computeDistributionData(sightings) {
      const countPerVehicle = {};
      for (const v of allVehiclesData) countPerVehicle[v.vin] = 0;
      for (const s of sightings) countPerVehicle[s.vehicleId] = (countPerVehicle[s.vehicleId] || 0) + 1;
      const histogram: Record<number, number> = {};
      for (const count of Object.values(countPerVehicle)) histogram[count] = (histogram[count] || 0) + 1;
      const CAP = 10;
      const labels = [], data = [];
      for (let i = 0; i < CAP; i++) { labels.push(String(i)); data.push(histogram[i] || 0); }
      const tail = Object.entries(histogram).filter(([k]) => Number(k) >= CAP).reduce((sum, [, v]) => sum + (v as number), 0);
      labels.push(`${CAP}+`); data.push(tail);
      return { labels, data };
    }

    function createSightingCountDistributionChart(sightings) {
      const { labels, data } = computeDistributionData(sightings);
      const chart = new Chart(document.getElementById('sightingCountDistributionChart'), {
        type: 'bar',
        data: { labels, datasets: [{ data, backgroundColor: CHART_COLOR, borderRadius: 2 }] },
        options: { ...CHART_DEFAULTS,
          animation: { duration: 150 },
          scales: {
            x: { ...CHART_DEFAULTS.scales.x, title: { display: true, text: 'Sighting Count', color: TEXT_COLOR, align: 'end' } },
            y: { ...CHART_DEFAULTS.scales.y, title: { display: true, text: 'Vehicles', color: TEXT_COLOR } }
          }
        }
      });
      return { setSightings(sightings) { chart.data.datasets[0].data = computeDistributionData(sightings).data; chart.update(); } };
    }

    let distributionMinDate = null;
    let distributionMaxDate = null;
    let distributionCutoffIndex = 0;
    let distributionPlaying = false;
    let distributionPlayTimer: ReturnType<typeof setInterval> | null = null;

    function daysBetween(a: Date, b: Date) { return Math.round((b.getTime() - a.getTime()) / 86400000); }

    function dateFromDistributionIndex(idx: number) {
      const d = new Date(distributionMinDate as Date);
      d.setDate(d.getDate() + idx);
      return d;
    }

    function applyDistributionCutoff(sightings: any[]) {
      if (!distributionMaxDate) return sightings;
      const cutoff = dateFromDistributionIndex(distributionCutoffIndex);
      cutoff.setHours(23, 59, 59, 999);
      return sightings.filter((s: any) => s.date <= cutoff);
    }

    function updateDistributionLabel() {
      const label = document.getElementById('distributionDateLabel');
      if (label) label.textContent = 'Through ' + dateFromDistributionIndex(distributionCutoffIndex).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
    }

    function updateDistributionQuickDateActive() {
      document.querySelectorAll('#distributionQuickDates .toggle-btn').forEach(btn => {
        btn.classList.toggle('active', Number((btn as HTMLElement).dataset.targetIndex) === distributionCutoffIndex);
      });
    }

    function setDistributionIndex(idx: number) {
      const maxIndex = distributionMinDate && distributionMaxDate ? daysBetween(distributionMinDate, distributionMaxDate) : 0;
      distributionCutoffIndex = Math.max(0, Math.min(idx, maxIndex));
      const slider = document.getElementById('distributionDateSlider') as HTMLInputElement | null;
      if (slider) slider.value = String(distributionCutoffIndex);
      updateDistributionLabel();
      updateDistributionQuickDateActive();
      if (charts.distribution) charts.distribution.setSightings(applyDistributionCutoff(filterSightings()));
    }

    function stopDistributionPlay() {
      distributionPlaying = false;
      if (distributionPlayTimer) clearInterval(distributionPlayTimer);
      distributionPlayTimer = null;
      const btn = document.getElementById('distributionPlayBtn');
      if (btn) { btn.textContent = '▶'; btn.classList.remove('active'); }
    }

    function startDistributionPlay() {
      const maxIndex = distributionMinDate && distributionMaxDate ? daysBetween(distributionMinDate, distributionMaxDate) : 0;
      if (distributionCutoffIndex >= maxIndex) setDistributionIndex(0);
      distributionPlaying = true;
      const btn = document.getElementById('distributionPlayBtn');
      if (btn) { btn.textContent = '❚❚'; btn.classList.add('active'); }
      distributionPlayTimer = setInterval(() => {
        if (distributionCutoffIndex >= maxIndex) { stopDistributionPlay(); return; }
        setDistributionIndex(distributionCutoffIndex + 1);
      }, 90);
    }

    function buildDistributionQuickDates() {
      const container = document.getElementById('distributionQuickDates');
      if (!container || !distributionMinDate || !distributionMaxDate) return;
      container.innerHTML = '';
      const buttons: { label: string, date: Date }[] = [];
      let y = distributionMinDate.getFullYear(), m = distributionMinDate.getMonth();
      while (true) {
        const monthStart = new Date(y, m, 1);
        if (monthStart > distributionMaxDate) break;
        if (monthStart >= distributionMinDate) buttons.push({ label: monthStart.toLocaleDateString('en-US', { month: 'short' }) + ' 1', date: monthStart });
        m++; if (m > 11) { m = 0; y++; }
      }
      buttons.push({ label: 'Today', date: distributionMaxDate });
      buttons.forEach(b => {
        const btn = document.createElement('button');
        btn.className = 'toggle-btn';
        btn.textContent = b.label;
        btn.dataset.targetIndex = String(daysBetween(distributionMinDate as Date, b.date));
        btn.addEventListener('click', () => { stopDistributionPlay(); setDistributionIndex(Number(btn.dataset.targetIndex)); });
        container.appendChild(btn);
      });
      updateDistributionQuickDateActive();
    }

    let tlcDebutUnit = 'week';
    let tlcDebutMetric = 'count';

    function getTlcDebutDate(vehicle) {
      let earliest = null;
      for (const plate of vehicle.license_plates || []) {
        const m = String(plate.first_reported_on || '').match(/^\d{4}-\d{2}-\d{2}/);
        if (!m) continue;
        if (!earliest || m[0] < earliest) earliest = m[0];
      }
      return earliest ? new Date(earliest + 'T12:00:00') : null;
    }

    function buildTlcDebutData(sightings) {
      const sightedVins = new Set(sightings.map(s => s.vehicleId));
      const buckets = {};
      for (const v of allVehiclesData) {
        const debut = getTlcDebutDate(v);
        if (!debut) continue;
        const key = getBucketKey(debut, tlcDebutUnit);
        if (!buckets[key]) buckets[key] = { sighted: 0, unsighted: 0 };
        if (sightedVins.has(v.vin)) buckets[key].sighted++;
        else buckets[key].unsighted++;
      }
      const keys = Object.keys(buckets).sort();
      const point = (key, count, total) => {
        const pct = total > 0 ? (count / total) * 100 : 0;
        return { x: new Date(key + 'T12:00:00'), y: tlcDebutMetric === 'share' ? pct : count, count, total, pct };
      };
      return {
        sightedData: keys.map(k => point(k, buckets[k].sighted, buckets[k].sighted + buckets[k].unsighted)),
        unsightedData: keys.map(k => point(k, buckets[k].unsighted, buckets[k].sighted + buckets[k].unsighted))
      };
    }

    function tlcDebutYTitle() { return tlcDebutMetric === 'share' ? '% of Oceans' : 'Oceans'; }

    function createTlcDebutChart(sightings) {
      const { sightedData, unsightedData } = buildTlcDebutData(sightings);
      const chart = new Chart(document.getElementById('tlcDebutChart'), {
        type: 'bar',
        data: { datasets: [
          { label: 'Sighted', data: sightedData, backgroundColor: '#e07b53', borderRadius: { topLeft: 0, topRight: 0, bottomLeft: 2, bottomRight: 2 } },
          { label: 'Not Yet Sighted', data: unsightedData, backgroundColor: '#dcdcdc', borderRadius: { topLeft: 2, topRight: 2, bottomLeft: 0, bottomRight: 0 } }
        ]},
        options: { ...CHART_DEFAULTS,
          plugins: {
            legend: { display: true, position: 'top', labels: { color: TEXT_COLOR, usePointStyle: true, pointStyle: 'rect' } },
            tooltip: { callbacks: {
              label: ctx => `${ctx.dataset.label}: ${ctx.raw.count.toLocaleString()} (${ctx.raw.pct.toFixed(1)}%)`,
              footer: items => items.length ? `${items[0].raw.total.toLocaleString()} Oceans first reported` : ''
            }}
          },
          scales: {
            x: { type: 'time', offset: true, bounds: 'ticks', time: { unit: tlcDebutUnit, isoWeekday: true, displayFormats: { day: 'MMM d, yyyy', week: 'MMM d, yyyy', month: 'MMM yyyy' }, tooltipFormat: 'MMM d, yyyy' }, stacked: true, grid: { display: false }, ticks: { color: TEXT_COLOR, font: { size: 11 }, autoSkip: true, maxTicksLimit: 14, maxRotation: 45 }, border: { color: 'rgba(0,0,0,0.1)' }, title: { display: true, text: 'TLC First Reported', color: TEXT_COLOR, align: 'end' } },
            y: { ...CHART_DEFAULTS.scales.y, stacked: true, min: 0, max: tlcDebutMetric === 'share' ? 100 : undefined, title: { display: true, text: tlcDebutYTitle(), color: TEXT_COLOR }, ticks: { color: TEXT_COLOR, font: { size: 11 }, callback: (v: number | string) => tlcDebutMetric === 'share' ? Number(v).toFixed(0) + '%' : Number(v).toLocaleString() } }
          }
        }
      });
      return { chart, refresh() {
        const { sightedData, unsightedData } = buildTlcDebutData(sightings);
        chart.data.datasets[0].data = sightedData;
        chart.data.datasets[1].data = unsightedData;
        chart.options.scales.x.time.unit = tlcDebutUnit;
        chart.options.scales.y.max = tlcDebutMetric === 'share' ? 100 : undefined;
        chart.options.scales.y.title.text = tlcDebutYTitle();
        chart.update();
      }};
    }

    function createFirstSightingRateChart(dailySightings) {
      const scatterData = [], lineData = [], rollingData = [];
      for (const d of dailySightings) {
        const x = new Date(d.date + 'T12:00:00');
        if (d.first_sighting_rate != null) scatterData.push({ x, y: d.first_sighting_rate * 100 });
        if (d.expected_first_sighting_rate != null) lineData.push({ x, y: d.expected_first_sighting_rate * 100 });
        if (d.rolling_first_sighting_rate != null) rollingData.push({ x, y: d.rolling_first_sighting_rate * 100 });
      }
      new Chart(document.getElementById('firstSightingRateChart'), {
        data: { datasets: [
          { type: 'scatter', label: 'Daily Actual', data: scatterData, backgroundColor: CHART_COLOR, pointRadius: 3, yAxisID: 'y' },
          { type: 'line', label: 'Last 200', data: rollingData, borderColor: CHART_COLOR, backgroundColor: 'transparent', tension: 0.2, pointRadius: 0, yAxisID: 'y' },
          { type: 'line', label: 'Expected', data: lineData, borderColor: '#e07b53', backgroundColor: 'transparent', tension: 0.2, pointRadius: 0, yAxisID: 'y' }
        ]},
        options: { ...CHART_DEFAULTS,
          plugins: { legend: { display: true, position: 'top', labels: { color: TEXT_COLOR, usePointStyle: true } } },
          scales: {
            x: { type: 'time', time: { unit: 'day', displayFormats: { day: 'MMM d' }, tooltipFormat: 'MMM d, yyyy' }, min: '2025-12-06', grid: { display: false }, ticks: { color: TEXT_COLOR, font: { size: 11 } }, border: { color: 'rgba(0,0,0,0.1)' }, title: { display: true, text: 'Date', color: TEXT_COLOR, align: 'end' } },
            y: { ...CHART_DEFAULTS.scales.y, min: 0, title: { display: true, text: '% of Sightings', color: TEXT_COLOR }, ticks: { ...CHART_DEFAULTS.scales.y.ticks, callback: (v: number | string) => Number(v).toFixed(0) + '%' } }
          }
        }
      });
    }


    const charts = {};

    function destroyCharts() {
      for (const key in charts) {
        if (charts[key]?.destroy) charts[key].destroy();
        else if (charts[key]?.chart?.destroy) charts[key].chart.destroy();
        delete charts[key];
      }
    }

    function resetCanvas(id) {
      const canvas = document.getElementById(id);
      const parent = canvas.parentElement;
      const newCanvas = document.createElement('canvas');
      newCanvas.id = id;
      parent.replaceChild(newCanvas, canvas);
    }

    function getActiveToggleUnit(toggleId) {
      const active = document.querySelector(`#${toggleId} .toggle-btn.active`);
      return active ? active.dataset.unit : 'day';
    }

    let allSightings = [];
    let allVehiclesData = [];
    let totalVehicles = 0;

    function filterSightings() {
      const contributor = document.getElementById('filterContributor').value;
      const borough = document.getElementById('filterBorough').value;
      return allSightings.filter(s => {
        if (contributor !== 'all' && s.contributor !== contributor) return false;
        if (borough !== 'all' && s.borough !== borough) return false;
        return true;
      });
    }

    function renderCharts() {
      destroyCharts();
      ['sightingsPerDayChart', 'cumulativeSightingsChart', 'sightingCountDistributionChart', 'tlcDebutChart', 'oceanPointsChart', 'cumulativeContributorsChart', 'weeklyUniqueContributorsChart', 'boroughMixChart', 'topVehiclesChart'].forEach(resetCanvas);
      const contributorsTbody = document.getElementById('contributorsTbody'); if (contributorsTbody) contributorsTbody.innerHTML = '';
      const sightings = filterSightings();
      const sightingsUnit = getActiveToggleUnit('sightingsToggle');
      const contributorsUnit = getActiveToggleUnit('contributorsToggle');
      charts.sightings = createSightingsPerDayChart(sightings);
      if (sightingsUnit !== 'day') charts.sightings.setUnit(sightingsUnit);
      createCumulativeSightingsChart(sightings, totalVehicles);
      charts.distribution = createSightingCountDistributionChart(applyDistributionCutoff(sightings));
      charts.tlcDebut = createTlcDebutChart(sightings);
      createOceanPointsChart(sightings);
      createCumulativeContributorsChart(sightings);
      charts.contributors = createWeeklyUniqueContributorsChart(sightings);
      if (contributorsUnit !== 'week') charts.contributors.setUnit(contributorsUnit);
      createContributorsTable(filterByPeriod(sightings, contributorsTimePeriod));
      createBoroughMixChart(sightings);
      createTopVehiclesChart(sightings);
    }

    function wireOptionToggle(toggleId, datasetKey, onPick) {
      const toggle = document.getElementById(toggleId);
      if (!toggle) return;
      toggle.addEventListener('click', e => {
        const btn = (e.target as Element).closest('.toggle-btn') as HTMLButtonElement | null;
        if (!btn) return;
        toggle.querySelectorAll('.toggle-btn').forEach(b => b.classList.toggle('active', b === btn));
        onPick(btn.dataset[datasetKey]);
      });
    }

    function wireToggle(toggleId, labelId, chartKey) {
      document.getElementById(toggleId).addEventListener('click', e => {
        const btn = e.target.closest('.toggle-btn');
        if (!btn) return;
        const unit = btn.dataset.unit;
        document.getElementById(toggleId).querySelectorAll('.toggle-btn').forEach(b => b.classList.toggle('active', b === btn));
        document.getElementById(labelId).textContent = unit.charAt(0).toUpperCase() + unit.slice(1);
        if (charts[chartKey]) charts[chartKey].setUnit(unit);
      });
    }

    async function init() {
      const isLocal = window.location.hostname === 'localhost';
      const [data, dailyData] = await Promise.all([
        fetch(isLocal ? '/oceans.json' : 'https://cdn.oceansofnyc.com/web/oceans.json').then(r => r.json()),
        fetch(isLocal ? '/daily_sightings.json' : 'https://cdn.oceansofnyc.com/web/daily_sightings.json').then(r => r.json()),
      ]);
      createFirstSightingRateChart(dailyData.daily_sightings);
      allVehiclesData = data.vehicles;
      totalVehicles = data.vehicles.length;
      allSightings = extractSightings(data.vehicles);

      if (allSightings.length > 0) {
        distributionMinDate = new Date(allSightings[0].date); distributionMinDate.setHours(0, 0, 0, 0);
        distributionMaxDate = new Date(allSightings[allSightings.length - 1].date); distributionMaxDate.setHours(0, 0, 0, 0);
      } else {
        distributionMinDate = new Date(); distributionMinDate.setHours(0, 0, 0, 0);
        distributionMaxDate = new Date(distributionMinDate);
      }
      const distributionMaxIndex = daysBetween(distributionMinDate, distributionMaxDate);
      distributionCutoffIndex = distributionMaxIndex;
      const distributionSlider = document.getElementById('distributionDateSlider') as HTMLInputElement;
      distributionSlider.min = '0';
      distributionSlider.max = String(distributionMaxIndex);
      distributionSlider.value = String(distributionMaxIndex);
      distributionSlider.addEventListener('input', e => { stopDistributionPlay(); setDistributionIndex(Number((e.target as HTMLInputElement).value)); });
      document.getElementById('distributionPlayBtn')?.addEventListener('click', () => { if (distributionPlaying) stopDistributionPlay(); else startDistributionPlay(); });
      buildDistributionQuickDates();
      updateDistributionLabel();

      const contributors = new Set();
      const boroughs = new Set();
      for (const s of allSightings) { if (s.contributor) contributors.add(s.contributor); if (s.borough) boroughs.add(s.borough); }

      const contributorSelect = document.getElementById('filterContributor');
      Array.from(contributors).sort().forEach(name => { const o = document.createElement('option'); o.value = name; o.textContent = name; contributorSelect.appendChild(o); });

      const boroughSelect = document.getElementById('filterBorough');
      Array.from(boroughs).sort().forEach(name => { const o = document.createElement('option'); o.value = name; o.textContent = name; boroughSelect.appendChild(o); });

      contributorSelect.addEventListener('change', renderCharts);
      boroughSelect.addEventListener('change', renderCharts);
      wireToggle('sightingsToggle', 'sightingsUnitLabel', 'sightings');
      wireToggle('contributorsToggle', 'contributorsUnitLabel', 'contributors');
      wireOptionToggle('tlcDebutUnitToggle', 'unit', unit => { tlcDebutUnit = unit; charts.tlcDebut?.refresh(); });
      wireOptionToggle('tlcDebutMetricToggle', 'metric', metric => { tlcDebutMetric = metric; charts.tlcDebut?.refresh(); });
      document.getElementById('contributorsTimeToggle')?.addEventListener('click', e => {
        const btn = (e.target as Element).closest('.toggle-btn') as HTMLButtonElement | null;
        if (!btn) return;
        contributorsTimePeriod = btn.dataset.period ?? 'all';
        document.getElementById('contributorsTimeToggle')?.querySelectorAll('.toggle-btn').forEach(b => b.classList.toggle('active', b === btn));
        createContributorsTable(filterByPeriod(filterSightings(), contributorsTimePeriod));
      });
      renderCharts();
    }

    init();
  </script>
</Layout>

<style>
  .stats-page {
    /* spacing-only overrides; container width comes from .page utilities */
  }

  .chart-section {
    margin-bottom: 48px;
  }

  .chart-section:first-child {
    margin-top: 8px;
  }

  .chart-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 16px;
  }

  .chart-header h2,
  .chart-section h2 {
    font-size: 18px;
    font-weight: 600;
    color: #333;
    margin-bottom: 16px;
  }

  .chart-header h2 {
    margin-bottom: 0;
  }

  .chart-toggle-group {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 16px;
  }

  .chart-toggle {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 4px;
  }

  .toggle-btn {
    background: none;
    border: 1px solid rgba(0, 0, 0, 0.2);
    border-radius: 4px;
    padding: 4px 10px;
    font-size: 12px;
    cursor: pointer;
    color: rgba(0, 0, 0, 0.5);
    transition: all 0.15s;
  }

  .toggle-btn:hover {
    border-color: rgba(0, 0, 0, 0.4);
    color: rgba(0, 0, 0, 0.7);
  }

  .toggle-btn.active {
    background: #333;
    color: white;
    border-color: #333;
  }

  .chart-container {
    position: relative;
    height: 250px;
  }

  .chart-container.medium {
    height: 300px;
  }

  .chart-container.tall {
    height: 320px;
  }

  .distribution-controls {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-top: 12px;
  }

  .distribution-controls input[type="range"] {
    flex: 1;
    accent-color: #333;
  }

  .distribution-date-label {
    font-size: 12px;
    color: rgba(0, 0, 0, 0.6);
    min-width: 118px;
    text-align: right;
    font-family: ui-monospace, 'SF Mono', Menlo, monospace;
  }

  .slider-play-btn {
    flex-shrink: 0;
    background: none;
    border: 1px solid rgba(0, 0, 0, 0.2);
    border-radius: 4px;
    width: 28px;
    height: 28px;
    font-size: 11px;
    line-height: 1;
    cursor: pointer;
    color: rgba(0, 0, 0, 0.6);
    transition: all 0.15s;
  }

  .slider-play-btn:hover {
    border-color: rgba(0, 0, 0, 0.4);
    color: rgba(0, 0, 0, 0.8);
  }

  .slider-play-btn.active {
    background: #333;
    color: white;
    border-color: #333;
  }

  :global(.stats-table) {
    width: 100%;
    border-collapse: collapse;
    font-size: 14px;
  }

  :global(.stats-table td.bar-cell) {
    background: linear-gradient(to right, rgba(107, 155, 209, 0.15) var(--pct), transparent var(--pct));
  }

  :global(.stats-table th.sortable) {
    cursor: pointer;
    user-select: none;
  }

  :global(.stats-table th.sortable::after) {
    content: ' ↕';
    opacity: 0.3;
  }

  :global(.stats-table th.sort-desc::after) {
    content: ' ↓';
    opacity: 1;
  }

  :global(.stats-table th.sort-asc::after) {
