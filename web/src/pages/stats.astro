    border-bottom: 1px solid rgba(0, 0, 0, 0.07);
    color: #333;
    font-family: ui-monospace, 'SF Mono', Menlo, monospace;
    font-size: 13px;
  }

  :global(.stats-table tr:last-child td) {
    border-bottom: none;
  }

  :global(.stats-table td:first-child),
  :global(.stats-table th:first-child) {
