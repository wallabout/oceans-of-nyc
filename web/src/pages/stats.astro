  }

  :global(.stats-table .top-borough-pct) {
    color: rgba(0, 0, 0, 0.45);
  }

  @media (max-width: 768px) {
    .chart-container { height: 200px; }
    .chart-container.medium { height: 250px; }
    .chart-container.tall { height: 280px; }
  }
</style>
