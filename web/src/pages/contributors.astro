---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Contributors — Oceans of NYC" currentPage="contributors">
  <main class="page page--medium contributors-page">
    <div class="page-header">
      <h1>Contributors</h1>
      <p>Everyone who has spotted an Ocean, ranked however you like. Click a column to sort, or a name to see their sightings and badges.</p>
    </div>

    <div class="table-controls">
      <div class="chart-toggle" id="contributorsTimeToggle">
        <button class="toggle-btn active" data-period="all">All Time</button>
        <button class="toggle-btn" data-period="30">Last 30 Days</button>
        <button class="toggle-btn" data-period="7">Last 7 Days</button>
      </div>
      <select class="filter-select" id="filterBorough">
        <option value="all">All Boroughs</option>
      </select>
    </div>

    <div class="table-scroll">
      <table class="stats-table" id="contributorsTable">
        <thead>
          <tr>
            <th>#</th>
            <th>Name</th>
            <th class="sortable sort-desc" data-col="totalSightings">Total Sightings</th>
            <th class="sortable" data-col="firstSightings">First Sightings</th>
            <th class="sortable" data-col="ops">◎p <a href="/p/ocean-points" title="What are Ocean Points?" class="op-info-icon">i</a></th>
            <th class="sortable" data-col="opsEfficiency" title="Ocean Point Efficiency is ◎p / sightings and gives an indication of the contributor's skill or luck in getting first sightings">◎pE</th>
            <th class="sortable" data-col="firstSightingAt">First Sighting</th>
            <th class="sortable" data-col="topBoroughPct">Top Borough</th>
          </tr>
        </thead>
        <tbody id="contributorsTbody"></tbody>
      </table>
    </div>
    <p class="loading" id="loading">Loading contributors…</p>
  </main>

  <script>
    let allSightings = [];
    let sortCol = 'totalSightings';
    let sortDir = 'desc';
    let timePeriod = 'all';
    let rows = [];

    function extractSightings(vehicles) {
      const sightings = [];
      for (const v of vehicles) {
        for (const s of v.sightings || []) {
          sightings.push({ date: new Date(s.timestamp), contributor: s.contributor || 'Unknown', contributorId: s.contributor_id ?? null, borough: s.borough, isFirstSighting: s.vehicle_sighting_index === 1, oceanPoints: s.ocean_points || 0 });
        }
      }
      return sightings;
    }

    function filterSightings() {
      const borough = (document.getElementById('filterBorough') as HTMLSelectElement).value;
      let cutoff = null;
      if (timePeriod !== 'all') {
        cutoff = new Date();
        cutoff.setDate(cutoff.getDate() - parseInt(timePeriod));
      }
      return allSightings.filter(s => {
        if (borough !== 'all' && s.borough !== borough) return false;
        if (cutoff && s.date < cutoff) return false;
        return true;
      });
    }

    function buildRows(sightings) {
      const byContributor = {};
      for (const s of sightings) {
        if (!byContributor[s.contributor]) byContributor[s.contributor] = { name: s.contributor, contributorId: s.contributorId, firstSightingAt: s.date, ops: 0, opsEfficiency: 0, firstSightings: 0, totalSightings: 0, boroughCounts: {} };
        const c = byContributor[s.contributor];
        if (s.date < c.firstSightingAt) c.firstSightingAt = s.date;
        c.ops += s.oceanPoints;
        if (s.isFirstSighting) c.firstSightings++;
        c.totalSightings++;
        const borough = s.borough || 'Unknown';
        c.boroughCounts[borough] = (c.boroughCounts[borough] || 0) + 1;
      }
      for (const c of Object.values(byContributor) as any[]) {
        let topBorough = null, topCount = 0;
        for (const [b, count] of Object.entries(c.boroughCounts) as [string, number][]) {
          if (count > topCount) { topCount = count; topBorough = b; }
        }
        c.topBorough = topBorough;
        c.topBoroughPct = c.totalSightings > 0 ? (topCount / c.totalSightings) * 100 : 0;
        c.opsEfficiency = c.totalSightings > 0 ? c.ops / c.totalSightings : 0;
      }
      return Object.values(byContributor);
    }

    function renderRows() {
      const sorted = [...rows].sort((a, b) => {
        const diff = b[sortCol] - a[sortCol];
        return sortDir === 'desc' ? diff : -diff;
      });
      const escapeHTML = s => String(s).replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
      const maxOps = Math.max(...rows.map(r => r.ops), 0);
      const maxOpsEff = Math.max(...rows.map(r => r.opsEfficiency), 0);
      const maxFirst = Math.max(...rows.map(r => r.firstSightings), 0);
      const maxTotal = Math.max(...rows.map(r => r.totalSightings), 0);
      const tbody = document.getElementById('contributorsTbody');
      if (!tbody) return;
      tbody.innerHTML = '';
      sorted.forEach((c, i) => {
        const tr = document.createElement('tr');
        const opsPct = maxOps ? (c.ops / maxOps * 100).toFixed(1) : '0';
        const opsEffPct = maxOpsEff ? (c.opsEfficiency / maxOpsEff * 100).toFixed(1) : '0';
        const firstPct = maxFirst ? (c.firstSightings / maxFirst * 100).toFixed(1) : '0';
        const totalPct = maxTotal ? (c.totalSightings / maxTotal * 100).toFixed(1) : '0';
        const firstSightingDate = c.firstSightingAt.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
        const nameCell = c.contributorId != null
          ? `<a class="contributor-link" href="/contributor/${c.contributorId}">${escapeHTML(c.name)}</a>`
          : escapeHTML(c.name);
        const topBoroughCell = c.topBorough
          ? `${escapeHTML(c.topBorough)} <span class="top-borough-pct">${c.topBoroughPct.toFixed(0)}%</span>`
          : '—';
        tr.innerHTML = `<td>${i + 1}</td><td>${nameCell}</td><td class="bar-cell" style="--pct:${totalPct}%">${c.totalSightings.toLocaleString()}</td><td class="bar-cell" style="--pct:${firstPct}%">${c.firstSightings.toLocaleString()}</td><td class="bar-cell" style="--pct:${opsPct}%">${c.ops.toFixed(1)}</td><td class="bar-cell" style="--pct:${opsEffPct}%">${c.opsEfficiency.toFixed(2)}</td><td>${firstSightingDate}</td><td>${topBoroughCell}</td>`;
        tbody.appendChild(tr);
      });
      document.querySelectorAll('#contributorsTable .sortable').forEach((th: HTMLElement) => {
        const active = th.dataset.col === sortCol;
        th.classList.toggle('sort-asc', active && sortDir === 'asc');
        th.classList.toggle('sort-desc', active && sortDir === 'desc');
      });
    }

    function refresh() {
      rows = buildRows(filterSightings());
      renderRows();
    }

    async function init() {
      const isLocal = window.location.hostname === 'localhost';
      const data = await fetch(isLocal ? '/oceans.json' : 'https://cdn.oceansofnyc.com/web/oceans.json').then(r => r.json());
      allSightings = extractSightings(data.vehicles);
      document.getElementById('loading')?.remove();

      const boroughs = new Set<string>();
      for (const s of allSightings) if (s.borough) boroughs.add(s.borough);
      const boroughSelect = document.getElementById('filterBorough') as HTMLSelectElement;
      Array.from(boroughs).sort().forEach(name => { const o = document.createElement('option'); o.value = name; o.textContent = name; boroughSelect.appendChild(o); });
      boroughSelect.addEventListener('change', refresh);

      const toggle = document.getElementById('contributorsTimeToggle');
      toggle?.addEventListener('click', e => {
        const btn = (e.target as Element).closest('.toggle-btn') as HTMLButtonElement | null;
        if (!btn) return;
        timePeriod = btn.dataset.period ?? 'all';
        toggle.querySelectorAll('.toggle-btn').forEach(b => b.classList.toggle('active', b === btn));
        refresh();
      });

      document.querySelectorAll('#contributorsTable .sortable').forEach((th: HTMLElement) => {
        th.addEventListener('click', e => {
          if ((e.target as Element).closest('a')) return;
          const col = th.dataset.col;
          if (col === sortCol) {
            sortDir = sortDir === 'desc' ? 'asc' : 'desc';
          } else {
            sortCol = col;
            sortDir = 'desc';
          }
          renderRows();
        });
      });

      refresh();
    }

    init();
  </script>
</Layout>

<style>
  .table-controls {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 8px;
    margin: 8px 0 16px;
  }

  .chart-toggle {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
  }

  .toggle-btn {
    background: none;
    border: 1px solid rgba(0, 0, 0, 0.2);
    border-radius: 4px;
    padding: 4px 10px;
    font-size: 12px;
    cursor: pointer;
    color: rgba(0, 0, 0, 0.5);
    transition: all 0.15s;
  }

  .toggle-btn:hover {
    border-color: rgba(0, 0, 0, 0.4);
    color: rgba(0, 0, 0, 0.7);
  }

  .toggle-btn.active {
    background: #333;
    color: white;
    border-color: #333;
  }

  .filter-select {
    padding: 4px var(--space-3);
    border: 1px solid rgba(0, 0, 0, 0.2);
    border-radius: var(--radius-sm);
    background: white;
    font-size: 12px;
    font-family: inherit;
    color: var(--color-text-body);
    cursor: pointer;
  }

  .table-scroll {
    overflow-x: auto;
  }

  .loading {
    color: #888;
    font-size: 14px;
    padding: 20px 0;
  }

  :global(.stats-table) {
    width: 100%;
    border-collapse: collapse;
    font-size: 14px;
  }

  :global(.stats-table td.bar-cell) {
    background: linear-gradient(to right, rgba(107, 155, 209, 0.15) var(--pct), transparent var(--pct));
  }

  :global(.stats-table th.sortable) {
    cursor: pointer;
    user-select: none;
  }

  :global(.stats-table th.sortable::after) {
    content: ' ↕';
    opacity: 0.3;
  }

  :global(.stats-table th.sort-desc::after) {
    content: ' ↓';
    opacity: 1;
  }

  :global(.stats-table th.sort-asc::after) {
    content: ' ↑';
    opacity: 1;
  }

  :global(.stats-table th) {
    text-align: left;
    padding: 8px 12px;
    border-bottom: 2px solid rgba(0, 0, 0, 0.15);
    color: rgba(0, 0, 0, 0.6);
    font-weight: 600;
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    white-space: nowrap;
  }

  :global(.stats-table td) {
    padding: 10px 12px;
    border-bottom: 1px solid rgba(0, 0, 0, 0.07);
    color: #333;
    font-family: ui-monospace, 'SF Mono', Menlo, monospace;
    font-size: 13px;
  }

  :global(.stats-table tr:last-child td) {
    border-bottom: none;
  }

  :global(.stats-table td:first-child),
  :global(.stats-table th:first-child) {
    color: rgba(0, 0, 0, 0.35);
    width: 36px;
  }

  :global(.stats-table td:nth-child(3)),
  :global(.stats-table td:nth-child(4)),
  :global(.stats-table td:nth-child(5)),
  :global(.stats-table td:nth-child(6)),
  :global(.stats-table th:nth-child(3)),
  :global(.stats-table th:nth-child(4)),
  :global(.stats-table th:nth-child(5)),
  :global(.stats-table th:nth-child(6)) {
    text-align: right;
  }

  :global(.stats-table .top-borough-pct) {
    color: rgba(0, 0, 0, 0.45);
  }
</style>
