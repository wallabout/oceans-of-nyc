---
import Layout from '../../layouts/Layout.astro';

export async function getStaticPaths() {
  let data;
  if (import.meta.env.DEV) {
    const { readFile } = await import('node:fs/promises');
    const { resolve } = await import('node:path');
    data = JSON.parse(await readFile(resolve('public/oceans.json'), 'utf-8'));
  } else {
    const res = await fetch('https://cdn.oceansofnyc.com/web/oceans.json', { cache: 'no-store' });
    data = await res.json();
  }
  return data.vehicles.map((vehicle: any) => ({
    params: { vin: vehicle.vin },
    props: { vehicle, badgeDefs: data.badge_definitions || [] },
  }));
}

const { vehicle, badgeDefs } = Astro.props;
const badgeDefsMap = new Map(badgeDefs.map((b: any) => [b.name, b]));
const platesDisplay = vehicle.license_plates.map((p: any) => p.license_plate).join(', ');
const sightingImages: string[] = vehicle.sightings?.filter((s: any) => s.image).map((s: any) => s.image) || [];

function fmtDateTime(ts: string) {
  const d = new Date(ts);
  return {
    date: d.toLocaleDateString('en-US', { month: 'numeric', day: 'numeric', year: 'numeric', timeZone: 'America/New_York' }),
    time: d.toLocaleTimeString('en-US', { hour: 'numeric', minute: '2-digit', hour12: true, timeZone: 'America/New_York' }),
  };
}

function fmtDate(dateStr: string) {
  const m = dateStr.match(/^(\d{4})-(\d{2})-(\d{2})/);
  if (!m) return dateStr;
  return `${parseInt(m[2])}/${parseInt(m[3])}/${m[1]}`;
}
---

<Layout title={`${platesDisplay} — Oceans of NYC`} currentPage="">
  <div class="vehicle-page">
    <div class="vehicle-header">
      <a href="/" class="back-link">← All Oceans</a>
      <h1 class="vehicle-plates">{platesDisplay}</h1>
      <div class="vehicle-vin">VIN: {vehicle.vin}</div>
    </div>

    {sightingImages.length > 0 ? (
      <div>
        <div class="modal-image-container">
          <img id="primaryImage" src={sightingImages[0]} alt={`Vehicle ${platesDisplay}`} class="modal-image" />
        </div>
        {sightingImages.length > 1 && (
          <div class="modal-image-gallery">
            {sightingImages.map((img: string, i: number) => (
              <img src={img} alt={`Sighting ${i + 1}`} class:list={['gallery-image', { active: i === 0 }]} data-index={String(i)} />
            ))}
          </div>
        )}
      </div>
    ) : (
      <div class="modal-placeholder">
        <img src="/fisker_ocean_placeholder.svg" alt="No sighting yet" />
      </div>
    )}

    <div class="vehicle-content">
      {vehicle.sightings && vehicle.sightings.length > 0 ? (
        <div class="sightings-section">
          <div class="sightings-title">Sightings ({vehicle.sightings.length})</div>
          <div class="table-scroll">
            <table class="sightings-table">
              <thead>
                <tr>
                  <th>Sighting #</th>
                  <th>Ocean #</th>
                  <th>Date &amp; Time</th>
                  <th>Borough</th>
                  <th>Contributor</th>
                  <th>Badges</th>
                </tr>
              </thead>
              <tbody>
                {vehicle.sightings.map((s: any) => {
                  const { date, time } = fmtDateTime(s.timestamp);
                  return (
                    <tr>
                      <td>#{s.global_sighting_index}</td>
                      <td>
                        {s.global_unique_sighting_index != null ? (
                          <div class="ocean-cell">
                            <span>#{s.global_unique_sighting_index}</span>
                            {s.ocean_points != null && <span class="feed-op-badge">{(s.ocean_points as number).toFixed(1)} OPs</span>}
                          </div>
                        ) : '—'}
                      </td>
                      <td>{date} {time}</td>
                      <td>{s.borough || '—'}</td>
                      <td>{s.contributor || '—'}</td>
                      <td>
                        {s.badges?.length > 0 ? (
                          <div class="feed-badges" style="margin-top:0">
                            {s.badges.map((b: any) => {
                              const def = badgeDefsMap.get(b.name);
                              return def ? <span class="feed-badge" title={def.description}>{def.emoji} {def.display_name}</span> : null;
                            })}
                          </div>
                        ) : '—'}
                      </td>
                    </tr>
                  );
                })}
              </tbody>
            </table>
          </div>
        </div>
      ) : (
        <p class="no-sightings">No sightings yet.</p>
      )}

      {vehicle.license_plates && vehicle.license_plates.length > 0 && (
        <div class="sightings-section">
          <div class="sightings-title">License Plate History</div>
          <div class="table-scroll">
            <table class="sightings-table">
              <thead>
                <tr>
                  <th>License Plate</th>
                  <th>First Reported</th>
                  <th>Most Recently Reported</th>
                </tr>
              </thead>
              <tbody>
                {vehicle.license_plates.map((record: any) => (
                  <tr>
                    <td>{record.license_plate}</td>
                    <td>{fmtDate(record.first_reported_on)}</td>
                    <td>{fmtDate(record.most_recently_reported_on)}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>
      )}
    </div>
  </div>

  <script>
    document.querySelector('.modal-image-gallery')?.addEventListener('click', e => {
      const img = (e.target as HTMLElement).closest('.gallery-image') as HTMLImageElement | null;
      if (!img) return;
      (document.getElementById('primaryImage') as HTMLImageElement).src = img.src;
      document.querySelectorAll('.gallery-image').forEach((gi, i) =>
        gi.classList.toggle('active', i === parseInt((img as HTMLImageElement).dataset.index!, 10))
      );
    });
  </script>
</Layout>

<style>
  .vehicle-page {
    max-width: 900px;
    margin: 0 auto;
    padding: 32px 20px 80px;
  }

  .vehicle-header {
    margin-bottom: 24px;
  }

  .back-link {
    display: inline-block;
    color: #666;
    text-decoration: none;
    font-size: 13px;
    font-weight: 600;
    margin-bottom: 16px;
    transition: color 0.15s;
  }

  .back-link:hover { color: #111; }

  .vehicle-plates {
    font-size: 28px;
    font-weight: 600;
    letter-spacing: 1px;
    margin-bottom: 6px;
  }

  .vehicle-vin {
    font-size: 13px;
    color: #888;
    font-family: ui-monospace, 'SF Mono', monospace;
  }

  .vehicle-content {
    padding: 20px 0;
  }

  .no-sightings {
    color: #999;
    padding: 20px 0;
  }

  .table-scroll {
    overflow-x: auto;
  }

  .ocean-cell {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .feed-op-badge {
    display: inline-block;
    background: #e0f2fe;
    color: #0369a1;
    font-size: 11px;
    font-weight: 600;
    padding: 2px 8px;
    border-radius: 10px;
    letter-spacing: 0.3px;
    width: fit-content;
  }
</style>
