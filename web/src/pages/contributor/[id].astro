---
import Layout from '../../layouts/Layout.astro';

export async function getStaticPaths() {
  let data;
  if (import.meta.env.DEV) {
    const { readFile } = await import('node:fs/promises');
    const { resolve } = await import('node:path');
    data = JSON.parse(await readFile(resolve('public/oceans.json'), 'utf-8'));
  } else {
    const res = await fetch('https://cdn.oceansofnyc.com/web/oceans.json', { cache: 'no-store' });
    data = await res.json();
  }

  const sightingsByContributor = new Map<number, any[]>();
  for (const vehicle of data.vehicles) {
    const primaryPlate = vehicle.license_plates?.[0]?.license_plate || vehicle.vin;
    for (const s of vehicle.sightings || []) {
      if (s.contributor_id == null) continue;
      const enriched = { ...s, vin: vehicle.vin, primary_plate: primaryPlate };
      const list = sightingsByContributor.get(s.contributor_id);
      if (list) list.push(enriched);
      else sightingsByContributor.set(s.contributor_id, [enriched]);
    }
  }

  return data.contributors.map((c: any) => ({
    params: { id: String(c.id) },
    props: {
      contributor: c,
      sightings: sightingsByContributor.get(c.id) || [],
      badgeDefs: data.badge_definitions || [],
    },
  }));
}

const { contributor, sightings, badgeDefs } = Astro.props;
const badgeDefsMap = new Map(badgeDefs.map((b: any) => [b.name, b]));
const displayName = contributor.preferred_name || contributor.bluesky_handle || `Contributor #${contributor.id}`;

const sortedSightings = [...sightings].sort((a: any, b: any) =>
  new Date(b.timestamp).getTime() - new Date(a.timestamp).getTime()
);

const trophies = [...contributor.badges]
  .map((b: any) => ({ ...b, def: badgeDefsMap.get(b.name) }))
  .filter((b: any) => b.def)
  .sort((a: any, b: any) => new Date(a.earned_on).getTime() - new Date(b.earned_on).getTime());

const totalSightings = sightings.length;
const firstSightingsCount = sightings.filter((s: any) => s.vehicle_sighting_index === 1).length;
const totalOPs = sightings.reduce((sum: number, s: any) => sum + (s.ocean_points || 0), 0);
const firstSightingTs = sightings.length > 0
  ? sightings.reduce((earliest: string, s: any) =>
      new Date(s.timestamp).getTime() < new Date(earliest).getTime() ? s.timestamp : earliest,
      sightings[0].timestamp)
  : null;

const BOROUGH_COLORS: Record<string, string> = {
  'Manhattan': '#5ab5a0',
  'Brooklyn': '#d4845a',
  'Queens': '#8b7ec8',
  'Bronx': '#c75b7a',
  'Staten Island': '#a8b035',
  'Unknown': '#999',
};
const boroughOrder = ['Manhattan', 'Brooklyn', 'Queens', 'Bronx', 'Staten Island', 'Unknown'];
const boroughCounts: Record<string, number> = {};
for (const s of sightings) {
  const b = s.borough || 'Unknown';
  boroughCounts[b] = (boroughCounts[b] || 0) + 1;
}
const boroughSegments = boroughOrder
  .filter(b => boroughCounts[b])
  .map(b => ({
    name: b,
    count: boroughCounts[b],
    pct: (boroughCounts[b] / totalSightings) * 100,
    color: BOROUGH_COLORS[b],
  }));

const opChartData = sightings
  .filter((s: any) => (s.ocean_points || 0) > 0)
  .map((s: any) => ({
    ts: s.timestamp,
    ops: s.ocean_points,
    isFirst: s.vehicle_sighting_index === 1,
  }));

function fmtDateTime(ts: string) {
  const d = new Date(ts);
  return {
    date: d.toLocaleDateString('en-US', { month: 'numeric', day: 'numeric', year: 'numeric', timeZone: 'America/New_York' }),
    time: d.toLocaleTimeString('en-US', { hour: 'numeric', minute: '2-digit', hour12: true, timeZone: 'America/New_York' }),
  };
}

function fmtEarnedDate(ts: string) {
  return new Date(ts).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
}

function fmtSightingSince(ts: string) {
  return new Date(ts).toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric', timeZone: 'America/New_York' });
}
---

<Layout title={`${displayName} — Oceans of NYC`} currentPage="">
  <Fragment slot="head">
    <script is:inline src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
    <script is:inline src="https://cdn.jsdelivr.net/npm/chartjs-adapter-date-fns@3.0.0/dist/chartjs-adapter-date-fns.bundle.min.js"></script>
  </Fragment>
  <div class="page page--medium">
    <a href="/stats" class="back-link">← All Contributors</a>
    <div class="page-header">
      <h1>{displayName}</h1>
      {contributor.bluesky_handle && (
        <p class="page-header__meta">
          <a href={`https://bsky.app/profile/${contributor.bluesky_handle.replace(/^@/, '')}`} target="_blank" rel="noopener noreferrer">
            {contributor.bluesky_handle}
          </a>
        </p>
      )}
      {firstSightingTs && (
        <p class="contributor-since">Sighting since {fmtSightingSince(firstSightingTs)}</p>
      )}
    </div>

    {totalSightings > 0 && (
      <div class="headline-stats">
        <div class="stat-card">
          <div class="stat-card__value">{totalSightings.toLocaleString()}</div>
          <div class="stat-card__label">Sightings</div>
        </div>
        <div class="stat-card">
          <div class="stat-card__value">{firstSightingsCount.toLocaleString()}</div>
          <div class="stat-card__label">First Sightings</div>
        </div>
        <div class="stat-card">
          <div class="stat-card__value">{totalOPs.toFixed(1)}</div>
          <div class="stat-card__label">Ocean Points</div>
        </div>
      </div>
    )}

    {opChartData.length > 0 && (
      <section class="page-section">
        <h2 class="page-section__title">Ocean Points Earned</h2>
        <div class="chart-container"><canvas id="opChart"></canvas></div>
        <script is:inline type="application/json" id="opChartData" set:html={JSON.stringify(opChartData)} />
      </section>
    )}

    {boroughSegments.length > 0 && (
      <section class="page-section">
        <h2 class="page-section__title">Borough Base</h2>
        <div class="borough-bar">
          {boroughSegments.map((b: any) => (
            <div
              class="borough-segment"
              style={`width: ${b.pct}%; background: ${b.color};`}
              title={`${b.name}: ${b.count} sightings (${b.pct.toFixed(1)}%)`}
            >
              {b.pct >= 10 && <span class="borough-segment__label">{b.pct.toFixed(0)}%</span>}
            </div>
          ))}
        </div>
        <div class="borough-legend">
          {boroughSegments.map((b: any) => (
            <div class="borough-legend__item">
              <span class="borough-legend__swatch" style={`background: ${b.color};`}></span>
              <span class="borough-legend__name">{b.name}</span>
              <span class="borough-legend__count">{b.count} ({b.pct.toFixed(1)}%)</span>
            </div>
          ))}
        </div>
      </section>
    )}

    <section class="page-section">
      <h2 class="page-section__title">Trophy Case ({trophies.length})</h2>
      {trophies.length > 0 ? (
        <div class="trophy-case">
          {trophies.map((b: any) => (
            <div class="trophy" title={b.def.description}>
              <div class="trophy__emoji">{b.def.emoji}</div>
              <div class="trophy__name">{b.def.display_name}</div>
              <div class="trophy__date">{fmtEarnedDate(b.earned_on)}</div>
            </div>
          ))}
        </div>
      ) : (
        <p class="empty-note">No badges earned yet.</p>
      )}
    </section>

    {sortedSightings.length > 0 ? (
      <section class="page-section">
        <h2 class="page-section__title">Sightings ({sortedSightings.length})</h2>
        <div class="table-scroll">
          <table class="sightings-table">
            <thead>
              <tr>
                <th class="thumb-col"></th>
                <th>Plate</th>
                <th>Ocean #</th>
                <th>OPs <a href="/p/ocean-points" title="What are Ocean Points?" class="op-info-icon">i</a></th>
                <th>Badges</th>
                <th>Borough</th>
                <th>Date &amp; Time</th>
              </tr>
            </thead>
            <tbody>
              {sortedSightings.map((s: any) => {
                const { date, time } = fmtDateTime(s.timestamp);
                return (
                  <tr>
                    <td class="thumb-col">
                      {s.image && (
                        <a href={`/ocean/${s.vin}`} class="sighting-thumb-link">
                          <img src={s.image} alt={`Sighting of ${s.primary_plate}`} class="sighting-thumb" loading="lazy" />
                        </a>
                      )}
                    </td>
                    <td><a href={`/ocean/${s.vin}`} class="plate-link">{s.primary_plate}</a></td>
                    <td>{s.global_unique_sighting_index != null ? `#${s.global_unique_sighting_index}` : '—'}</td>
                    <td>
                      {s.ocean_points != null && s.ocean_points > 0
                        ? <a href="/p/ocean-points" class="feed-op-badge" title="What are Ocean Points?">{(s.ocean_points as number).toFixed(1)}</a>
                        : '—'}
                    </td>
                    <td>
                      {s.badges?.length > 0 ? (
                        <div class="feed-badges" style="margin-top:0">
                          {s.badges.map((b: any) => {
                            const def = badgeDefsMap.get(b.name);
                            return def ? <span class="feed-badge" title={def.description}>{def.emoji} {def.display_name}</span> : null;
                          })}
                        </div>
                      ) : '—'}
                    </td>
                    <td>{s.borough || '—'}</td>
                    <td>{date} {time}</td>
                  </tr>
                );
              })}
            </tbody>
          </table>
        </div>
      </section>
    ) : (
      <p class="empty-note">No sightings yet.</p>
    )}
  </div>

  <script is:inline>
    (function renderOPChart() {
      const dataEl = document.getElementById('opChartData');
      const canvas = document.getElementById('opChart');
      if (!dataEl || !canvas || typeof Chart === 'undefined') return;
      const raw = JSON.parse(dataEl.textContent || '[]');
      if (raw.length === 0) return;

      const CHART_COLOR = '#6b9bd1';
      const FIRST_COLOR = '#e07b53';
      const TEXT_COLOR = 'rgba(0,0,0,0.7)';

      const dateKey = (ts) => new Date(ts).toLocaleDateString('en-CA', { timeZone: 'America/New_York' });
      const byDate = {};
      for (const s of raw) {
        const k = dateKey(s.ts);
        (byDate[k] = byDate[k] || []).push(s);
      }
      const dates = Object.keys(byDate).sort();
      for (const k of dates) byDate[k].sort((a, b) => b.ops - a.ops);
      const maxPerDay = Math.max(...dates.map(k => byDate[k].length));

      const datasets = [];
      for (let i = 0; i < maxPerDay; i++) {
        const firstData = [], dupData = [];
        for (const k of dates) {
          const s = byDate[k][i];
          const x = new Date(k + 'T12:00:00');
          firstData.push({ x, y: s && s.isFirst ? s.ops : 0 });
          dupData.push({ x, y: s && !s.isFirst ? s.ops : 0 });
        }
        datasets.push({
          label: i === 0 ? 'First Sighting' : '',
          data: firstData,
          backgroundColor: FIRST_COLOR,
          borderColor: '#fff',
          borderWidth: 1,
          stack: 'ops',
        });
        datasets.push({
          label: i === 0 ? 'Duplicate' : '',
          data: dupData,
          backgroundColor: CHART_COLOR,
          borderColor: '#fff',
          borderWidth: 1,
          stack: 'ops',
        });
      }

      new Chart(canvas, {
        type: 'bar',
        data: { datasets },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          plugins: {
            legend: {
              display: true,
              position: 'top',
              labels: {
                color: TEXT_COLOR,
                usePointStyle: true,
                pointStyle: 'rect',
                filter: (item) => item.text && item.text.length > 0,
              },
            },
            tooltip: {
              callbacks: {
                title: (items) => {
                  if (!items.length) return '';
                  const d = new Date(items[0].parsed.x);
                  return d.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
                },
                label: (ctx) => {
                  if (ctx.parsed.y === 0) return null;
                  const kind = ctx.dataset.stack === 'ops' && ctx.datasetIndex % 2 === 0 ? 'First' : 'Duplicate';
                  return `${kind}: ${ctx.parsed.y.toFixed(1)} OP`;
                },
              },
            },
          },
          scales: {
            x: {
              type: 'time',
              time: { unit: 'day', displayFormats: { day: 'MMM d' }, tooltipFormat: 'MMM d, yyyy' },
              stacked: true,
              grid: { display: false },
              ticks: { color: TEXT_COLOR, font: { size: 11 } },
              border: { color: 'rgba(0,0,0,0.1)' },
              title: { display: true, text: 'Date', color: TEXT_COLOR, align: 'end' },
            },
            y: {
              stacked: true,
              grid: { color: 'rgba(0,0,0,0.1)' },
              ticks: { color: TEXT_COLOR, font: { size: 11 } },
              border: { display: false },
              title: { display: true, text: 'Ocean Points', color: TEXT_COLOR },
            },
          },
        },
      });
    })();
  </script>
</Layout>

<style>
  .contributor-since {
    margin-top: 6px;
    font-size: 13px;
    color: #888;
    font-family: ui-monospace, 'SF Mono', Menlo, monospace;
  }

  .headline-stats {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 12px;
    margin-top: 24px;
  }

  .stat-card {
    background: #f8faff;
    border: 1px solid #d0d9f5;
    border-radius: 8px;
    padding: 16px 12px;
    text-align: center;
  }

  .stat-card__value {
    font-size: 28px;
    font-weight: 700;
    color: #3b5bdb;
    font-family: ui-monospace, 'SF Mono', Menlo, monospace;
    line-height: 1.1;
  }

  .stat-card__label {
    margin-top: 4px;
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    color: #666;
    font-weight: 600;
  }

  @media (max-width: 540px) {
    .stat-card__value { font-size: 22px; }
    .stat-card { padding: 12px 8px; }
  }

  .chart-container {
    position: relative;
    height: 260px;
  }

  .borough-bar {
    display: flex;
    width: 100%;
    height: 32px;
    border-radius: 6px;
    overflow: hidden;
    border: 1px solid #e0e0e0;
  }

  .borough-segment {
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    transition: opacity 0.15s;
  }

  .borough-segment:hover {
    opacity: 0.85;
  }

  .borough-segment__label {
    font-size: 11px;
    font-weight: 600;
    color: #fff;
    text-shadow: 0 1px 1px rgba(0, 0, 0, 0.25);
    white-space: nowrap;
  }

  .borough-legend {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 16px;
    margin-top: 12px;
    font-size: 12px;
  }

  .borough-legend__item {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: #333;
  }

  .borough-legend__swatch {
    width: 10px;
    height: 10px;
    border-radius: 2px;
    display: inline-block;
  }

  .borough-legend__name {
    font-weight: 600;
  }

  .borough-legend__count {
    color: #888;
    font-family: ui-monospace, 'SF Mono', Menlo, monospace;
  }

  .trophy-case {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(100px, 1fr));
    gap: 8px;
  }

  .trophy {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 3px;
    padding: 10px 8px;
    background: #f8faff;
    border: 1px solid #d0d9f5;
    border-radius: 8px;
  }

  .trophy__emoji {
    font-size: 24px;
    line-height: 1;
  }

  .trophy__name {
    font-size: 11px;
    font-weight: 600;
    color: #3b5bdb;
  }

  .trophy__date {
    font-size: 10px;
    color: #888;
    font-family: ui-monospace, 'SF Mono', Menlo, monospace;
  }

  .plate-link {
    font-family: ui-monospace, 'SF Mono', Menlo, monospace;
    color: inherit;
    text-decoration: none;
    border-bottom: 1px dotted currentColor;
  }

  .plate-link:hover {
    color: #3b5bdb;
  }

  .thumb-col {
    width: 64px;
    padding: 4px !important;
  }

  .sighting-thumb-link {
    display: block;
    line-height: 0;
  }

  .sighting-thumb {
    width: 56px;
    height: 56px;
    object-fit: cover;
    border-radius: 6px;
    display: block;
    transition: transform 0.15s, box-shadow 0.15s;
  }

  .sighting-thumb:hover {
    transform: scale(1.05);
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.15);
  }

  .table-scroll {
    overflow-x: auto;
    border: 1px solid #e0e0e0;
    border-radius: 8px;
    background: #fff;
  }

  .ocean-cell {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .empty-note {
    color: #888;
    padding: 20px 0;
  }

  .page-header__meta a {
    color: inherit;
    text-decoration: none;
    border-bottom: 1px dotted currentColor;
  }

  .page-header__meta a:hover {
    color: #3b5bdb;
  }
</style>
