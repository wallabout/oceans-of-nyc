---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

const posts = (await getCollection('blog'))
  .filter(post => !post.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---
<Layout title="Blog — Oceans of NYC" currentPage="blog">
  <div class="page page--medium">
    <div class="page-header">
      <h1>Blog</h1>
      <p>Updates, milestones, and stories from the community.</p>
    </div>

    {posts.length === 0 ? (
      <p class="empty">No posts yet.</p>
    ) : (
      <div class="data-list">
        {posts.map(post => (
          <a href={`/blog/${post.id}`} class="data-list__row">
            <time class="data-list__date">
              {post.data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })}
            </time>
            <div class="data-list__body">
              <span class="data-list__title">{post.data.title}</span>
              {post.data.description && <span class="data-list__description">{post.data.description}</span>}
            </div>
            <span class="data-list__arrow">→</span>
          </a>
        ))}
      </div>
    )}
  </div>
</Layout>

<style>
  .empty {
    color: #888;
    font-size: 14px;
    padding: 20px 0;
  }
</style>
