---
import Layout from '../layouts/Layout.astro';
---
<Layout title="About — Oceans of NYC" currentPage="about">
  <main class="page page--narrow">
    <div class="page-header">
      <h1>About Oceans of NYC</h1>
      <p>A community-driven project tracking every Fisker Ocean operating in New York City.</p>
    </div>

    <div class="prose">
      <span class="tag">Full content coming soon</span>
      <p>What started as a simple curiosity has grown into a collaborative effort, with contributors across all five boroughs helping document these distinctive electric vehicles on our streets.</p>
      <p>Want to contribute? <a href="/submit">Submit a sighting</a> when you spot one!</p>
    </div>
  </main>
</Layout>

<style>
  .prose p {
    font-size: 15px;
    line-height: 1.65;
    color: #333;
    margin-bottom: 16px;
  }

  .prose p:last-child {
    margin-bottom: 0;
  }

  .prose a {
    color: #111;
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-thickness: 1px;
  }

  .prose a:hover {
    text-decoration-thickness: 2px;
  }

  .tag {
    display: inline-block;
    background: #f5f5f5;
    color: #666;
    padding: 4px 12px;
    border-radius: 12px;
    font-size: 12px;
    font-weight: 500;
    margin-bottom: 20px;
  }
</style>
