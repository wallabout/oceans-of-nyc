---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Feed — Oceans of NYC" currentPage="feed" filterBar={true}>
  <div class="filter-bar" id="filterBar">
    <select class="filter-select" id="filterType">
      <option value="all">All Sightings</option>
      <option value="first">First Sightings</option>
      <option value="badge">Badge</option>
    </select>
    <select class="filter-select" id="filterContributor">
      <option value="all">All Contributors</option>
    </select>
    <select class="filter-select" id="filterBorough">
      <option value="all">All Boroughs</option>
    </select>
    <input type="text" class="filter-select filter-plate" id="filterPlate" placeholder="Search by plate..." autocomplete="off" />
    <span class="filter-results" id="filterResults"></span>
  </div>

  <div class="loading" id="loading">Loading sightings...</div>

  <div class="feed" id="feed"></div>

  <div class="feed-more" id="feedMore" hidden>
    <button type="button" class="feed-more-button" id="feedMoreButton">Show more sightings</button>
  </div>

  <script>
    import { loadTagData, countsFor, renderTagChips, openTagModal, EMPTY_TAG_DATA } from '../lib/tags';
    import { buildFeedCard } from '../lib/feedCard';

    let tagData = EMPTY_TAG_DATA;

    // The newest sightings are published as small static pages (feed_pages/N.json,
    // built by web/generate_data.py) so the feed paints without the whole of
    // oceans.json. That full file is only fetched when someone filters or
    // scrolls past the last static page.
    const isLocal = window.location.hostname === 'localhost';
    const CDN = isLocal ? '' : 'https://cdn.oceansofnyc.com/web';
    const DATA_URL = `${CDN}/oceans.json`;
    const feedPageURL = (page: number) => `${CDN}/feed_pages/${page}.json`;
    const PAGE_SIZE = 50;

    type FeedItem = { sighting: any; vehicle: any };

    let items: FeedItem[] = [];        // newest first; every sighting once `full`
    const seenIds = new Set<string>();
    let full = false;
    let staticPages = 1;
    let nextPage = 1;
    let limit = PAGE_SIZE;             // cards shown for the current filters
    let badgeDefsMap = new Map();
    const cards = new Map<FeedItem, HTMLElement>();
    let pending: Promise<void> | null = null;

    const feedEl = document.getElementById('feed')!;
    const moreEl = document.getElementById('feedMore')!;
    const moreButton = document.getElementById('feedMoreButton') as HTMLButtonElement;

    function getFilters() {
      return {
        type: (document.getElementById('filterType') as HTMLSelectElement).value,
        contributor: (document.getElementById('filterContributor') as HTMLSelectElement).value,
        borough: (document.getElementById('filterBorough') as HTMLSelectElement).value,
        plate: (document.getElementById('filterPlate') as HTMLInputElement).value.trim(),
      };
    }

    function isFiltered(f = getFilters()) {
      return f.type !== 'all' || f.contributor !== 'all' || f.borough !== 'all' || f.plate !== '';
    }

    function getViewURL() {
      const f = getFilters();
      const params = new URLSearchParams();
      if (f.type !== 'all') params.set('type', f.type);
      if (f.contributor !== 'all') params.set('contributor', f.contributor);
      if (f.borough !== 'all') params.set('borough', f.borough);
      if (f.plate) params.set('plate', f.plate);
      const qs = params.toString();
      return '/feed' + (qs ? '?' + qs : '');
    }

    function matches({ sighting, vehicle }: FeedItem, f: ReturnType<typeof getFilters>) {
      const plate = f.plate.toLowerCase();
      if (f.type === 'first' && sighting.global_unique_sighting_index == null) return false;
      if (f.type === 'badge' && !(sighting.badges?.length > 0)) return false;
      if (f.contributor !== 'all' && sighting.contributor !== f.contributor) return false;
      if (f.borough !== 'all' && sighting.borough !== f.borough) return false;
      if (plate && !vehicle.license_plates.some((p: { license_plate: string }) => p.license_plate.toLowerCase().includes(plate))) return false;
      return true;
    }

    function cardFor(item: FeedItem) {
      let card = cards.get(item);
      if (!card) {
        card = buildFeedCard(item.sighting, item.vehicle, { badgeDefs: badgeDefsMap });
        card.querySelectorAll<HTMLElement>('[data-tags-for]').forEach(renderChipsInto);
        cards.set(item, card);
      }
      return card;
    }

    function render() {
      const f = getFilters();
      const filtered = isFiltered(f);
      const matching = items.filter(item => matches(item, f));
      feedEl.replaceChildren(...matching.slice(0, limit).map(cardFor));

      let resultsText = '';
      if (filtered && !full) resultsText = 'Searching all sightings…';
      else if (filtered) resultsText = `Showing ${matching.length.toLocaleString()} of ${items.length.toLocaleString()} sightings`;
      document.getElementById('filterResults')!.textContent = resultsText;

      moreEl.hidden = !(matching.length > limit || (!full && !filtered));
    }

    function addItems(newItems: FeedItem[]) {
      newItems.forEach(item => {
        const id = String(item.sighting.id);
        // Pages are regenerated as sightings come in, so a later page can repeat
        // cards that were on the end of an earlier one.
        if (seenIds.has(id)) return;
        seenIds.add(id);
        items.push(item);
      });
    }

    function populateSelect(id: string, values: string[]) {
      const select = document.getElementById(id) as HTMLSelectElement;
      values.forEach(value => {
        if ([...select.options].some(o => o.value === value)) return;
        const o = document.createElement('option');
        o.value = value; o.textContent = value;
        select.appendChild(o);
      });
    }

    async function loadFeedPage(page: number) {
      const response = await fetch(feedPageURL(page));
      if (!response.ok) throw new Error(`feed page ${page}: ${response.status}`);
      const data = await response.json();
      if (page === 1) {
        staticPages = data.pages;
        badgeDefsMap = new Map((data.badge_definitions || []).map(b => [b.name, b]));
        populateSelect('filterContributor', data.contributors || []);
        populateSelect('filterBorough', data.boroughs || []);
      }
      addItems(data.items);
      nextPage = page + 1;
      if (!data.has_more) full = true;
    }

    async function loadFull() {
      const data = await fetch(DATA_URL).then(r => r.json());
      badgeDefsMap = new Map((data.badge_definitions || []).map(b => [b.name, b]));

      const contributors = new Set<string>();
      const boroughs = new Set<string>();
      const pairs: FeedItem[] = [];
      data.vehicles.forEach(vehicle => vehicle.sightings?.forEach(sighting => {
        if (sighting.contributor) contributors.add(sighting.contributor);
        if (sighting.borough) boroughs.add(sighting.borough);
        pairs.push({ sighting, vehicle });
      }));
      populateSelect('filterContributor', Array.from(contributors).sort());
      populateSelect('filterBorough', Array.from(boroughs).sort());
      pairs.sort((a, b) => new Date(b.sighting.timestamp).getTime() - new Date(a.sighting.timestamp).getTime());

      // Keep the cards already on screen (and their DOM nodes) in place.
      const shown = new Map(items.map(item => [String(item.sighting.id), item]));
      items = pairs.map(pair => shown.get(String(pair.sighting.id)) || pair);
      seenIds.clear();
      items.forEach(item => seenIds.add(String(item.sighting.id)));
      full = true;
    }

    /** Make sure `items` holds enough sightings to fill `limit` cards for the current filters. */
    function ensureLoaded(): Promise<void> {
      if (pending) return pending;
      const needsMore = !full && (isFiltered() || items.length < limit);
      if (!needsMore) return Promise.resolve();
      const load = isFiltered() || nextPage > staticPages ? loadFull() : loadFeedPage(nextPage);
      pending = load.finally(() => { pending = null; });
      return pending.then(ensureLoaded);
    }

    function update() {
      render();
      ensureLoaded()
        .then(render)
        .catch(error => {
          document.getElementById('filterResults')!.textContent = 'Error loading sightings: ' + error.message;
        });
    }

    function onFilterChange() {
      limit = PAGE_SIZE;
      history.replaceState(null, '', getViewURL());
      update();
    }

    function showMore() {
      if (moreEl.hidden || pending) return;
      limit += PAGE_SIZE;
      update();
    }

    moreButton.addEventListener('click', showMore);
    // Load the next page a little before the button scrolls into view.
    new IntersectionObserver(entries => {
      if (entries.some(e => e.isIntersecting)) showMore();
    }, { rootMargin: '800px 0px' }).observe(moreEl);

    function setFiltersFromURL() {
      const params = new URLSearchParams(window.location.search);
      (document.getElementById('filterType') as HTMLSelectElement).value = params.get('type') || 'all';
      // Contributor and borough options only exist once data lands, so add
      // the requested one up front; filtering on an unknown value just matches nothing.
      const contributor = params.get('contributor') || 'all';
      if (contributor !== 'all') populateSelect('filterContributor', [contributor]);
      (document.getElementById('filterContributor') as HTMLSelectElement).value = contributor;
      const borough = params.get('borough') || 'all';
      if (borough !== 'all') populateSelect('filterBorough', [borough]);
      (document.getElementById('filterBorough') as HTMLSelectElement).value = borough;
      (document.getElementById('filterPlate') as HTMLInputElement).value = params.get('plate') || '';
    }

    ['filterType', 'filterContributor', 'filterBorough'].forEach(id =>
      document.getElementById(id)!.addEventListener('change', onFilterChange));
    document.getElementById('filterPlate')!.addEventListener('input', onFilterChange);

    window.addEventListener('popstate', () => {
      setFiltersFromURL();
      limit = PAGE_SIZE;
      update();
    });

    setFiltersFromURL();
    const firstLoad = isFiltered() ? loadFull() : loadFeedPage(1).catch(() => loadFull());
    firstLoad
      .then(() => {
        document.getElementById('loading')!.style.display = 'none';
        update();
      })
      .catch(error => {
        document.getElementById('loading')!.textContent = 'Error loading data: ' + error.message;
      });

    // Tag counts live in their own file (tags.json) because they change far more
    // often than sightings do. Cards render immediately; chips fill in whenever
    // that fetch lands.
    loadTagData().then(data => {
      tagData = data;
      renderAllTagChips();
    });

    function renderChipsInto(container: HTMLElement) {
      const sightingId = container.dataset.tagsFor;
      if (!sightingId) return;
      container.innerHTML = renderTagChips(countsFor(tagData, sightingId), tagData.tag_definitions);
    }

    function renderAllTagChips() {
      // Includes cards built but filtered out of view, so they're current when they return.
      cards.forEach(card => card.querySelectorAll<HTMLElement>('[data-tags-for]').forEach(renderChipsInto));
    }

    feedEl.addEventListener('click', (event) => {
      const button = (event.target as HTMLElement).closest('.tag-button') as HTMLElement | null;
      if (!button) return;
      // Feed cards are wholly covered by a link overlay — keep the click here.
      event.preventDefault();
      event.stopPropagation();
      const sightingId = button.dataset.tagSighting;
      openTagModal(sightingId, tagData.tag_definitions, () => {
        const container = document.querySelector<HTMLElement>(`[data-tags-for="${sightingId}"]`);
        if (container) renderChipsInto(container);
      });
    });

  </script>
</Layout>
