---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Feed — Oceans of NYC" currentPage="feed" filterBar={true}>
  <div class="filter-bar" id="filterBar">
    <select class="filter-select" id="filterType">
      <option value="all">All Sightings</option>
      <option value="first">First Sightings</option>
      <option value="badge">Badge</option>
    </select>
    <select class="filter-select" id="filterContributor">
      <option value="all">All Contributors</option>
    </select>
    <select class="filter-select" id="filterBorough">
      <option value="all">All Boroughs</option>
    </select>
    <input type="text" class="filter-select filter-plate" id="filterPlate" placeholder="Search by plate..." autocomplete="off" />
    <span class="filter-results" id="filterResults"></span>
  </div>

  <div class="loading" id="loading">Loading sightings...</div>

  <div class="feed" id="feed"></div>

  <script>
    function getViewURL() {
      const params = new URLSearchParams();
      const type = document.getElementById('filterType').value;
      const contributor = document.getElementById('filterContributor').value;
      const borough = document.getElementById('filterBorough').value;
      const plate = (document.getElementById('filterPlate') as HTMLInputElement).value.trim();
      if (type !== 'all') params.set('type', type);
      if (contributor !== 'all') params.set('contributor', contributor);
      if (borough !== 'all') params.set('borough', borough);
      if (plate) params.set('plate', plate);
      const qs = params.toString();
      return '/feed' + (qs ? '?' + qs : '');
    }

    let allSightings = [];
    let allFeedCards = [];
    let badgeDefsMap = new Map();

    function applyFilters() {
      const typeFilter = document.getElementById('filterType').value;
      const contributorFilter = document.getElementById('filterContributor').value;
      const boroughFilter = document.getElementById('filterBorough').value;
      const plateFilter = (document.getElementById('filterPlate') as HTMLInputElement).value.trim().toLowerCase();
      let visibleCount = 0;
      allFeedCards.forEach((card, index) => {
        const { sighting, vehicle } = allSightings[index] as { sighting: any; vehicle: any };
        let show = true;
        if (typeFilter === 'first' && sighting.global_unique_sighting_index == null) show = false;
        if (typeFilter === 'badge' && !(sighting.badges?.length > 0)) show = false;
        if (show && contributorFilter !== 'all' && sighting.contributor !== contributorFilter) show = false;
        if (show && boroughFilter !== 'all' && sighting.borough !== boroughFilter) show = false;
        if (show && plateFilter && !vehicle.license_plates.some((p: { license_plate: string }) => p.license_plate.toLowerCase().includes(plateFilter))) show = false;
        card.style.display = show ? '' : 'none';
        if (show) visibleCount++;
      });
      const resultsText = visibleCount === allSightings.length ? '' : `Showing ${visibleCount.toLocaleString()} of ${allSightings.length.toLocaleString()} sightings`;
      document.getElementById('filterResults').textContent = resultsText;
    }

    const DATA_URL = window.location.hostname === 'localhost' ? '/oceans.json' : 'https://cdn.oceansofnyc.com/web/oceans.json';
    fetch(DATA_URL)
      .then(r => r.json())
      .then(data => {
        document.getElementById('loading').style.display = 'none';

        const contributors = new Set();
        const boroughs = new Set();
        data.vehicles.forEach(v => v.sightings?.forEach(s => {
          if (s.contributor) contributors.add(s.contributor);
          if (s.borough) boroughs.add(s.borough);
        }));

        const contributorSelect = document.getElementById('filterContributor');
        Array.from(contributors).sort().forEach(c => {
          const o = document.createElement('option');
          o.value = c; o.textContent = c;
          contributorSelect.appendChild(o);
        });

        const boroughSelect = document.getElementById('filterBorough');
        Array.from(boroughs).sort().forEach(b => {
          const o = document.createElement('option');
          o.value = b; o.textContent = b;
          boroughSelect.appendChild(o);
        });

        document.getElementById('filterType').addEventListener('change', () => { applyFilters(); history.replaceState(null, '', getViewURL()); });
        document.getElementById('filterContributor').addEventListener('change', () => { applyFilters(); history.replaceState(null, '', getViewURL()); });
        document.getElementById('filterBorough').addEventListener('change', () => { applyFilters(); history.replaceState(null, '', getViewURL()); });
        document.getElementById('filterPlate')!.addEventListener('input', () => { applyFilters(); history.replaceState(null, '', getViewURL()); });

        badgeDefsMap = new Map((data.badge_definitions || []).map(b => [b.name, b]));

        const feedEl = document.getElementById('feed');
        const sightingPairs = [];
        data.vehicles.forEach(vehicle => {
          vehicle.sightings?.forEach(sighting => sightingPairs.push({ sighting, vehicle }));
        });
        sightingPairs.sort((a, b) => new Date(b.sighting.timestamp) - new Date(a.sighting.timestamp));

        const escapeHTML = (s) => String(s).replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));

        sightingPairs.forEach(({ sighting, vehicle }) => {
          const card = document.createElement('div');
          const isFirst = sighting.global_unique_sighting_index != null;
          card.className = 'feed-card' + (isFirst ? ' feed-card-first' : '');
          const platesText = vehicle.license_plates.map(p => p.license_plate).join(', ');
          const date = new Date(sighting.timestamp);
          const formattedDate = date.toLocaleDateString('en-US', { month: 'numeric', day: 'numeric', year: 'numeric' });
          const formattedTime = date.toLocaleTimeString('en-US', { hour: 'numeric', minute: '2-digit', hour12: true });
          const badgesHTML = sighting.badges?.length > 0
            ? `<div class="feed-badges">${sighting.badges.map(b => { const def = badgeDefsMap.get(b.name); return def ? `<span class="feed-badge" title="${escapeHTML(def.description)}">${def.emoji} ${escapeHTML(def.display_name)}</span>` : ''; }).join('')}</div>`
            : '';
          const opOverlay = isFirst && sighting.ocean_points != null
            ? `<a href="/p/ocean-points" class="feed-op-badge feed-op-badge-overlay"><span class="feed-op-badge-num">${sighting.ocean_points.toFixed(1)}</span> OPs</a>`
            : '';
          const imageInner = sighting.image
            ? `<img src="${escapeHTML(sighting.image)}" alt="Vehicle ${escapeHTML(platesText)}" class="feed-card-image" loading="lazy">`
            : `<div class="feed-card-placeholder"><img src="/fisker_ocean_placeholder.svg" alt="No photo"></div>`;
          const imageHTML = `<div class="feed-card-image-wrap">${imageInner}${opOverlay}</div>`;
          const plateLink = `<a class="feed-card-main-link" href="/ocean/${encodeURIComponent(vehicle.vin)}">${escapeHTML(platesText)}</a>`;
          const contributorPart = sighting.contributor
            ? ` from ${sighting.contributor_id != null
                ? `<a class="feed-card-contributor-link" href="/contributor/${sighting.contributor_id}">${escapeHTML(sighting.contributor)}</a>`
                : escapeHTML(sighting.contributor)}`
            : '';
          const plateLabel = plateLink + contributorPart;
          const metaParts = [
            isFirst ? `<span class="feed-first-badge">Ocean #${sighting.global_unique_sighting_index}</span>` : '',
            sighting.global_sighting_index != null ? `<span>Sighting #${sighting.global_sighting_index}</span>` : '',
            sighting.borough ? `<span>in ${escapeHTML(sighting.borough)}</span>` : '',
            `<span>at ${formattedDate} ${formattedTime}</span>`,
          ].filter(Boolean).join('');
          card.innerHTML = `${imageHTML}<div class="feed-card-body"><div class="feed-card-plate">${plateLabel}</div><div class="feed-card-meta">${metaParts}</div>${badgesHTML}</div>`;
          feedEl.appendChild(card);
          allFeedCards.push(card);
          allSightings.push({ sighting, vehicle });
        });

        initFromURL();
      })
      .catch(error => {
        document.getElementById('loading').textContent = 'Error loading data: ' + error.message;
      });

    function initFromURL() {
      const params = new URLSearchParams(window.location.search);
      (document.getElementById('filterType') as HTMLSelectElement).value = params.get('type') || 'all';
      const contributorEl = document.getElementById('filterContributor') as HTMLSelectElement;
      const contributor = params.get('contributor') || 'all';
      if ([...contributorEl.options].some(o => o.value === contributor)) contributorEl.value = contributor;
      const boroughEl = document.getElementById('filterBorough') as HTMLSelectElement;
      const borough = params.get('borough') || 'all';
      if ([...boroughEl.options].some(o => o.value === borough)) boroughEl.value = borough;
      (document.getElementById('filterPlate') as HTMLInputElement).value = params.get('plate') || '';
      applyFilters();
    }

    window.addEventListener('popstate', () => {
      const params = new URLSearchParams(window.location.search);
      (document.getElementById('filterType') as HTMLSelectElement).value = params.get('type') || 'all';
      const contributorEl = document.getElementById('filterContributor') as HTMLSelectElement;
      const contributor = params.get('contributor') || 'all';
      contributorEl.value = [...contributorEl.options].some(o => o.value === contributor) ? contributor : 'all';
      const boroughEl = document.getElementById('filterBorough') as HTMLSelectElement;
      const borough = params.get('borough') || 'all';
      boroughEl.value = [...boroughEl.options].some(o => o.value === borough) ? borough : 'all';
      (document.getElementById('filterPlate') as HTMLInputElement).value = params.get('plate') || '';
      applyFilters();
    });
  </script>
</Layout>

<style is:global>
  .feed {
    display: flex;
    max-width: 760px;
    margin: 0 auto;
    padding: 20px;
    gap: 16px;
    flex-direction: column;
  }

  .feed-card {
    position: relative;
    border: 1px solid #e0e0e0;
    border-radius: 12px;
    overflow: hidden;
    background: white;
    transition: box-shadow 0.2s;
    color: inherit;
    display: block;
  }

  .feed-card-main-link {
    color: inherit;
    text-decoration: none;
  }

  .feed-card-main-link::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
    cursor: pointer;
  }

  .feed-card-contributor-link {
    position: relative;
    z-index: 2;
    color: inherit;
    text-decoration: none;
    border-bottom: 1px dotted currentColor;
  }

  .feed-card-contributor-link:hover {
    color: #3b5bdb;
  }

  .feed-card:hover {
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.12);
  }

  .feed-card-first {
    border-color: #0369a1;
    box-shadow: 0 0 0 1px #0369a1;
  }

  .feed-card-first:hover {
    box-shadow: 0 0 0 1px #0369a1, 0 4px 16px rgba(3, 105, 161, 0.18);
  }

  .feed-card-first .feed-card-body {
    background: #e0f2fe;
  }

  .feed-card-image-wrap {
    position: relative;
  }

  .feed-op-badge-overlay {
    position: absolute;
    top: 12px;
    right: 12px;
    font-size: 13px;
    padding: 4px 10px;
    background: rgba(224, 242, 254, 0.95);
    box-shadow: 0 1px 4px rgba(0, 0, 0, 0.2);
    backdrop-filter: blur(4px);
    display: inline-flex;
    align-items: baseline;
    gap: 3px;
  }

  .feed-op-badge-num {
    font-size: 20px;
    font-weight: 700;
    line-height: 1;
  }

  .feed-card-image {
    width: 100%;
    max-height: 420px;
    object-fit: cover;
    display: block;
  }

  .feed-card-placeholder {
    width: 100%;
    aspect-ratio: 16/9;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #f5f5f5;
  }

  .feed-card-placeholder img {
    width: 80px;
    opacity: 0.2;
  }

  .feed-card-body {
    padding: 16px 20px;
  }

  .feed-card-plate {
    font-size: 20px;
    font-weight: 700;
    letter-spacing: 1px;
    margin-bottom: 8px;
    color: #111;
  }

  .feed-card-meta {
    display: flex;
    gap: 6px;
    align-items: center;
    font-size: 13px;
    color: #666;
    flex-wrap: wrap;
  }

  @media (max-width: 768px) {
    .feed {
      padding: 12px;
      gap: 12px;
    }
  }
</style>
