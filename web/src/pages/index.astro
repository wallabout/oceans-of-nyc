---
import Layout from '../layouts/Layout.astro';
import { loadOceans } from '../lib/oceansData';

// The grid itself is drawn client-side, so without this the static HTML
// carries no indexable text at all. The intro and the counts below are
// rendered at build time for search engines (and the no-JS / slow-network case).
const data = await loadOceans();
const sighted = data.sighted.toLocaleString('en-US');
const total = data.total.toLocaleString('en-US');
const percent = ((data.sighted / data.total) * 100).toFixed(1);
const totalSightings = data.vehicles
  .reduce((sum: number, v: any) => sum + (v.sightings?.length || 0), 0)
  .toLocaleString('en-US');

const description = `Oceans of NYC is a community scavenger hunt to photograph every Fisker Ocean driving in New York City. ${sighted} of ${total} Fisker Oceans found so far across ${totalSightings} sightings in Manhattan, Brooklyn, Queens, the Bronx and Staten Island.`;

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': 'https://oceansofnyc.com/#website',
      url: 'https://oceansofnyc.com/',
      name: 'Oceans of NYC',
      alternateName: ['Oceans of New York', 'Fisker Oceans of NYC'],
      description,
      publisher: { '@id': 'https://oceansofnyc.com/#org' },
    },
    {
      '@type': 'Organization',
      '@id': 'https://oceansofnyc.com/#org',
      name: 'Oceans of NYC',
      url: 'https://oceansofnyc.com/',
      logo: 'https://oceansofnyc.com/oceans_of_nyc_logo.png',
      sameAs: ['https://bsky.app/profile/oceansofnyc.com'],
    },
  ],
};
---
<Layout
  title="Oceans of NYC — Spotting every Fisker Ocean in New York City"
  description={description}
  jsonLd={jsonLd}
  currentPage="index"
  filterBar={true}
  navStats={false}
  bodyClass="home"
>
  <header class="home-hero">
    <div class="home-hero__intro">
      <h1>Spotting every Fisker Ocean in New York City</h1>
      <p>
        Fisker went bankrupt in 2024, but its Oceans still drive NYC as for-hire cars.
        We're photographing every one. <a href="/p/what-is-oceans-of-nyc">How it works&nbsp;→</a>
      </p>
    </div>
    <div class="home-hero__progress">
      <p class="home-hero__count">
        <span><strong data-stat="sighted">{sighted}</strong> of <span data-stat="total">{total}</span> Oceans found</span>
        <span class="home-hero__percent" data-stat="percent">{percent}%</span>
      </p>
      <div class="home-hero__bar" role="presentation"><span data-stat-bar style={`width: ${percent}%`}></span></div>
      <p class="home-hero__sightings"><span data-stat="sightings">{totalSightings}</span> sightings and counting</p>
    </div>
  </header>

  <div class="filter-bar" id="filterBar">
    <select class="filter-select" id="filterStatus">
      <option value="all">All Status</option>
      <option value="sighted">Sighted</option>
      <option value="multiple">Multiple Sightings</option>
      <option value="not-sighted">Not Yet Sighted</option>
      <option value="inactive">Inactive</option>
    </select>
    <select class="filter-select" id="filterContributor">
      <option value="all">All Contributors</option>
    </select>
    <select class="filter-select" id="filterBorough">
      <option value="all">All Boroughs</option>
    </select>
    <input type="text" class="filter-select filter-plate" id="filterPlate" placeholder="Search by plate..." autocomplete="off" />
    <span class="filter-results" id="filterResults"></span>
  </div>

  <div class="loading" id="loading">Loading vehicle data...</div>

  <div class="grid" id="grid"></div>

  <script>
    function getViewURL() {
      const params = new URLSearchParams();
      const status = document.getElementById('filterStatus').value;
      const contributor = document.getElementById('filterContributor').value;
      const borough = document.getElementById('filterBorough').value;
      const plate = (document.getElementById('filterPlate') as HTMLInputElement).value.trim();
      if (status !== 'all') params.set('status', status);
      if (contributor !== 'all') params.set('contributor', contributor);
      if (borough !== 'all') params.set('borough', borough);
      if (plate) params.set('plate', plate);
      const qs = params.toString();
      return '/' + (qs ? '?' + qs : '');
    }

    let allVehicles = [];
    let allTiles = [];
    let maxReportedOn = '';

    function applyFilters() {
      const statusFilter = document.getElementById('filterStatus').value;
      const contributorFilter = document.getElementById('filterContributor').value;
      const boroughFilter = document.getElementById('filterBorough').value;
      const plateFilter = (document.getElementById('filterPlate') as HTMLInputElement).value.trim().toLowerCase();
      let tileVisibleCount = 0;
      allTiles.forEach((tile, index) => {
        const vehicle = allVehicles[index];
        let show = true;
        const sightingCount = vehicle.sightings?.length || 0;
        if (statusFilter === 'sighted' && sightingCount === 0) show = false;
        else if (statusFilter === 'multiple' && sightingCount <= 1) show = false;
        else if (statusFilter === 'not-sighted' && sightingCount > 0) show = false;
        else if (statusFilter === 'inactive' && vehicle.license_plates.some((p: { most_recently_reported_on: string }) => p.most_recently_reported_on === maxReportedOn)) show = false;
        if (show && contributorFilter !== 'all' && !vehicle.sightings?.some(s => s.contributor === contributorFilter)) show = false;
        if (show && boroughFilter !== 'all' && !vehicle.sightings?.some(s => s.borough === boroughFilter)) show = false;
        if (show && plateFilter && !vehicle.license_plates.some((p: { license_plate: string }) => p.license_plate.toLowerCase().includes(plateFilter))) show = false;
        tile.style.display = show ? '' : 'none';
        if (show) tileVisibleCount++;
      });
      const resultsText = tileVisibleCount === allVehicles.length ? '' : `Showing ${tileVisibleCount.toLocaleString()} of ${allVehicles.length.toLocaleString()} vehicles`;
      document.getElementById('filterResults').textContent = resultsText;
    }

    const DATA_URL = window.location.hostname === 'localhost' ? '/oceans.json' : 'https://cdn.oceansofnyc.com/web/oceans.json';
    fetch(DATA_URL)
      .then(r => r.json())
      .then(data => {
        document.getElementById('loading').style.display = 'none';
        maxReportedOn = data.vehicles.reduce((max: string, v: any) =>
          v.license_plates.reduce((m: string, p: any) => p.most_recently_reported_on > m ? p.most_recently_reported_on : m, max), '');

        const contributors = new Set();
        const boroughs = new Set();
        data.vehicles.forEach(vehicle => vehicle.sightings?.forEach(s => {
          if (s.contributor) contributors.add(s.contributor);
          if (s.borough) boroughs.add(s.borough);
        }));

        const contributorSelect = document.getElementById('filterContributor');
        Array.from(contributors).sort().forEach(c => { const o = document.createElement('option'); o.value = c; o.textContent = c; contributorSelect.appendChild(o); });

        const boroughSelect = document.getElementById('filterBorough');
        Array.from(boroughs).sort().forEach(b => { const o = document.createElement('option'); o.value = b; o.textContent = b; boroughSelect.appendChild(o); });

        document.getElementById('filterStatus').addEventListener('change', () => { applyFilters(); history.replaceState(null, '', getViewURL()); });
        document.getElementById('filterContributor').addEventListener('change', () => { applyFilters(); history.replaceState(null, '', getViewURL()); });
        document.getElementById('filterBorough').addEventListener('change', () => { applyFilters(); history.replaceState(null, '', getViewURL()); });
        document.getElementById('filterPlate')!.addEventListener('input', () => { applyFilters(); history.replaceState(null, '', getViewURL()); });
        for (let i = data.vehicles.length - 1; i > 0; i--) {
          const j = Math.floor(Math.random() * (i + 1));
          [data.vehicles[i], data.vehicles[j]] = [data.vehicles[j], data.vehicles[i]];
        }

        const grid = document.getElementById('grid');
        data.vehicles.forEach(vehicle => {
          const tile = document.createElement('a');
          tile.className = 'tile';
          tile.href = `/ocean/${vehicle.vin}`;
          const img = document.createElement('img');
          img.loading = 'lazy';
          const platesText = vehicle.license_plates.map(p => p.license_plate).join(', ');
          img.alt = `Fisker Ocean ${platesText}`;
          const latestImage = vehicle.sightings?.slice().reverse().find(s => s.image)?.image;
          if (latestImage) {
            img.src = latestImage;
          } else {
            tile.classList.add('placeholder');
            img.src = '/fisker_ocean_placeholder.svg';
          }
          tile.appendChild(img);
          const info = document.createElement('div');
          info.className = 'tile-info';
          info.innerHTML = `<div class="plate">${platesText}</div>`;
          tile.appendChild(info);
          grid.appendChild(tile);
          allTiles.push(tile);
        });

        allVehicles = data.vehicles;
        initFromURL();
      })
      .catch(error => {
        document.getElementById('loading').textContent = 'Error loading data: ' + error.message;
      });

    function initFromURL() {
      const params = new URLSearchParams(window.location.search);
      (document.getElementById('filterStatus') as HTMLSelectElement).value = params.get('status') || 'all';
      const contributorEl = document.getElementById('filterContributor') as HTMLSelectElement;
      const contributor = params.get('contributor') || 'all';
      if ([...contributorEl.options].some(o => o.value === contributor)) contributorEl.value = contributor;
      const boroughEl = document.getElementById('filterBorough') as HTMLSelectElement;
      const borough = params.get('borough') || 'all';
      if ([...boroughEl.options].some(o => o.value === borough)) boroughEl.value = borough;
      (document.getElementById('filterPlate') as HTMLInputElement).value = params.get('plate') || '';
      applyFilters();
    }

    window.addEventListener('popstate', () => {
      const params = new URLSearchParams(window.location.search);
      (document.getElementById('filterStatus') as HTMLSelectElement).value = params.get('status') || 'all';
      const contributorEl = document.getElementById('filterContributor') as HTMLSelectElement;
      const contributor = params.get('contributor') || 'all';
      contributorEl.value = [...contributorEl.options].some(o => o.value === contributor) ? contributor : 'all';
      const boroughEl = document.getElementById('filterBorough') as HTMLSelectElement;
      const borough = params.get('borough') || 'all';
      boroughEl.value = [...boroughEl.options].some(o => o.value === borough) ? borough : 'all';
      (document.getElementById('filterPlate') as HTMLInputElement).value = params.get('plate') || '';
      applyFilters();
    });
  </script>
</Layout>

<style is:global>
  body {
    overflow-x: hidden;
  }

  /* Masthead: continues the black nav so the intro reads as part of the
     header, then the filter bar and grid follow as one unit. */
  .home-hero {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--space-10);
    padding: var(--space-5) var(--space-5) var(--space-6);
    background: #000;
    color: white;
  }

  .home-hero__intro {
    max-width: 62ch;
  }

  .home-hero h1 {
    font-size: 26px;
    font-weight: 600;
    line-height: 1.2;
    letter-spacing: -0.015em;
    margin-bottom: var(--space-2);
  }

  .home-hero__intro p {
    font-size: 15px;
    line-height: 1.5;
    color: rgba(255, 255, 255, 0.7);
  }

  .home-hero__intro a {
    color: white;
    font-weight: 500;
    text-decoration: underline;
    text-decoration-color: rgba(255, 255, 255, 0.4);
    text-underline-offset: 3px;
    white-space: nowrap;
  }

  .home-hero__intro a:hover {
    text-decoration-color: white;
  }

  .home-hero__progress {
    flex: 0 0 300px;
  }

  .home-hero__count {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-3);
    font-size: 14px;
    color: rgba(255, 255, 255, 0.7);
    font-variant-numeric: tabular-nums;
  }

  .home-hero__count strong {
    font-size: 24px;
    font-weight: 600;
    color: white;
    letter-spacing: -0.01em;
  }

  .home-hero__percent {
    font-weight: 600;
    color: white;
  }

  .home-hero__bar {
    height: 6px;
    margin: var(--space-2) 0;
    border-radius: 3px;
    background: rgba(255, 255, 255, 0.15);
    overflow: hidden;
  }

  .home-hero__bar span {
    display: block;
    height: 100%;
    border-radius: inherit;
    background: #f07c2a;
  }

  .home-hero__sightings {
    font-size: 12px;
    color: rgba(255, 255, 255, 0.5);
    font-variant-numeric: tabular-nums;
  }

  /* The masthead scrolls away and the filter bar pins under the nav, rather
     than the filters sitting fixed above the intro. Phones keep the bottom
     filter drawer. */
  body.home .nav {
    border-bottom-color: transparent;
  }

  body.home.has-filter-bar {
    padding-top: var(--nav-height);
  }

  @media (min-width: 769px) {
    body.home .filter-bar {
      position: sticky;
    }
  }

  @media (max-width: 768px) {
    .home-hero {
      flex-direction: column;
      align-items: stretch;
      gap: var(--space-4);
      padding: var(--space-2) var(--space-4) var(--space-4);
    }

    .home-hero h1 {
      font-size: 19px;
      margin-bottom: var(--space-1);
    }

    .home-hero__intro p {
      font-size: 14px;
    }

    .home-hero__progress {
      flex-basis: auto;
    }

    .home-hero__count strong {
      font-size: 20px;
    }
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(100px, 1fr));
  }

  .tile {
    aspect-ratio: 1;
    position: relative;
    overflow: hidden;
    background: #ffffff;
    cursor: pointer;
    transition: transform 0.2s ease;
    text-decoration: none;
    color: inherit;
    display: block;
  }

  .tile:hover {
    transform: scale(1.05);
    z-index: 10;
  }

  .tile img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .tile.placeholder img {
    width: 80%;
    height: 80%;
    object-fit: contain;
    opacity: 0.3;
  }

  .tile-info {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    background: linear-gradient(to top, rgba(0, 0, 0, 0.9) 0%, rgba(0, 0, 0, 0) 100%);
    color: white;
    padding: 20px 10px 10px;
    font-size: 11px;
    opacity: 0;
    transition: opacity 0.2s ease;
  }

  .tile:hover .tile-info {
    opacity: 1;
  }

  .plate {
    font-weight: 600;
    font-size: 13px;
    letter-spacing: 0.5px;
    font-family: ui-monospace, "SF Mono", Menlo, monospace;
  }
</style>
