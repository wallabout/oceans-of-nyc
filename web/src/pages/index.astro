---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Oceans of NYC" currentPage="index" filterBar={true}>
  <div class="filter-bar" id="filterBar">
    <select class="filter-select" id="filterStatus">
      <option value="all">All Status</option>
      <option value="sighted">Sighted</option>
      <option value="multiple">Multiple Sightings</option>
      <option value="not-sighted">Not Yet Sighted</option>
    </select>
    <select class="filter-select" id="filterContributor">
      <option value="all">All Contributors</option>
    </select>
    <select class="filter-select" id="filterBorough">
      <option value="all">All Boroughs</option>
    </select>
    <input type="text" class="filter-select filter-plate" id="filterPlate" placeholder="Search by plate..." autocomplete="off" />
    <span class="filter-results" id="filterResults"></span>
  </div>

  <div class="loading" id="loading">Loading vehicle data...</div>

  <div class="grid" id="grid"></div>

  <div class="modal-overlay" id="submitModal">
    <div class="modal">
      <div class="modal-header">
        <div class="modal-title">Submit a Sighting</div>
        <button class="modal-close" id="submitModalClose">×</button>
      </div>
      <div class="modal-content">
        <form id="submitForm">
          <div class="form-group">
            <label class="form-label" for="submitImage">Photo</label>
            <input type="file" id="submitImage" name="image" accept="image/*" class="form-input" required />
            <div class="form-hint">Upload a photo of the Fisker Ocean</div>
          </div>
          <div class="form-group">
            <label class="form-label" for="submitPlate">License Plate</label>
            <input type="text" id="submitPlate" name="license_plate" placeholder="T123456C or 123456" class="form-input" required />
            <div class="form-hint">Enter the TLC plate number (6 digits or full T######C format)</div>
          </div>
          <div class="form-group">
            <label class="form-label" for="submitBorough">Borough</label>
            <select id="submitBorough" name="borough" class="form-select" required>
              <option value="">Select borough...</option>
              <option value="Manhattan">Manhattan</option>
              <option value="Brooklyn">Brooklyn</option>
              <option value="Queens">Queens</option>
              <option value="Bronx">Bronx</option>
              <option value="Staten Island">Staten Island</option>
            </select>
          </div>
          <div class="form-group">
            <label class="form-label" for="submitName">Your Name</label>
            <input type="text" id="submitName" name="contributor_name" placeholder="Enter your name" class="form-input" required />
            <div class="form-hint">How you'd like to be credited</div>
          </div>
          <button type="submit" class="form-submit" id="submitButton">Submit Sighting</button>
        </form>
        <div class="submit-status" id="submitStatus"></div>
      </div>
    </div>
  </div>

  <script>
    function openSubmitModal() { document.getElementById('submitModal').classList.add('active'); }
    function closeSubmitModal() {
      document.getElementById('submitModal').classList.remove('active');
      document.getElementById('submitForm').reset();
      document.getElementById('submitStatus').className = 'submit-status';
      document.getElementById('submitStatus').textContent = '';
    }
    document.getElementById('submitModalClose').addEventListener('click', closeSubmitModal);
    document.getElementById('submitModal').addEventListener('click', (e) => { if (e.target.id === 'submitModal') closeSubmitModal(); });

    document.getElementById('submitForm').addEventListener('submit', async (e) => {
      e.preventDefault();
      const submitButton = document.getElementById('submitButton');
      const submitStatus = document.getElementById('submitStatus');
      submitButton.disabled = true;
      submitButton.textContent = 'Submitting...';
      submitStatus.className = 'submit-status';
      submitStatus.textContent = '';
      try {
        const response = await fetch('https://wallabout--oceans-of-nyc-web-submission-webhook.modal.run/submit', { method: 'POST', body: new FormData(e.target) });
        const result = await response.json();
        if (result.success) {
          submitStatus.className = 'submit-status success';
          submitStatus.textContent = result.message;
          e.target.reset();
          setTimeout(() => window.location.reload(), 2000);
        } else {
          submitStatus.className = 'submit-status error';
          submitStatus.textContent = result.message || 'An error occurred. Please try again.';
        }
      } catch (error) {
        submitStatus.className = 'submit-status error';
        submitStatus.textContent = 'Network error. Please check your connection and try again.';
      } finally {
        submitButton.disabled = false;
        submitButton.textContent = 'Submit Sighting';
      }
    });

    function getViewURL() {
      const params = new URLSearchParams();
      const status = document.getElementById('filterStatus').value;
      const contributor = document.getElementById('filterContributor').value;
      const borough = document.getElementById('filterBorough').value;
      const plate = (document.getElementById('filterPlate') as HTMLInputElement).value.trim();
      if (status !== 'all') params.set('status', status);
      if (contributor !== 'all') params.set('contributor', contributor);
      if (borough !== 'all') params.set('borough', borough);
      if (plate) params.set('plate', plate);
      const qs = params.toString();
      return '/' + (qs ? '?' + qs : '');
    }

    let allVehicles = [];
    let allTiles = [];

    function applyFilters() {
      const statusFilter = document.getElementById('filterStatus').value;
      const contributorFilter = document.getElementById('filterContributor').value;
      const boroughFilter = document.getElementById('filterBorough').value;
      const plateFilter = (document.getElementById('filterPlate') as HTMLInputElement).value.trim().toLowerCase();
      let tileVisibleCount = 0;
      allTiles.forEach((tile, index) => {
        const vehicle = allVehicles[index];
        let show = true;
        const sightingCount = vehicle.sightings?.length || 0;
        if (statusFilter === 'sighted' && sightingCount === 0) show = false;
        else if (statusFilter === 'multiple' && sightingCount <= 1) show = false;
        else if (statusFilter === 'not-sighted' && sightingCount > 0) show = false;
        if (show && contributorFilter !== 'all' && !vehicle.sightings?.some(s => s.contributor === contributorFilter)) show = false;
        if (show && boroughFilter !== 'all' && !vehicle.sightings?.some(s => s.borough === boroughFilter)) show = false;
        if (show && plateFilter && !vehicle.license_plates.some((p: { license_plate: string }) => p.license_plate.toLowerCase().includes(plateFilter))) show = false;
        tile.style.display = show ? '' : 'none';
        if (show) tileVisibleCount++;
      });
      const resultsText = tileVisibleCount === allVehicles.length ? '' : `Showing ${tileVisibleCount.toLocaleString()} of ${allVehicles.length.toLocaleString()} vehicles`;
      document.getElementById('filterResults').textContent = resultsText;
    }

    const DATA_URL = window.location.hostname === 'localhost' ? '/oceans.json' : 'https://cdn.oceansofnyc.com/web/oceans.json';
    fetch(DATA_URL)
      .then(r => r.json())
      .then(data => {
        document.getElementById('loading').style.display = 'none';

        const contributors = new Set();
        const boroughs = new Set();
        data.vehicles.forEach(vehicle => vehicle.sightings?.forEach(s => {
          if (s.contributor) contributors.add(s.contributor);
          if (s.borough) boroughs.add(s.borough);
        }));

        const contributorSelect = document.getElementById('filterContributor');
        Array.from(contributors).sort().forEach(c => { const o = document.createElement('option'); o.value = c; o.textContent = c; contributorSelect.appendChild(o); });

        const boroughSelect = document.getElementById('filterBorough');
        Array.from(boroughs).sort().forEach(b => { const o = document.createElement('option'); o.value = b; o.textContent = b; boroughSelect.appendChild(o); });

        document.getElementById('filterStatus').addEventListener('change', () => { applyFilters(); history.replaceState(null, '', getViewURL()); });
        document.getElementById('filterContributor').addEventListener('change', () => { applyFilters(); history.replaceState(null, '', getViewURL()); });
        document.getElementById('filterBorough').addEventListener('change', () => { applyFilters(); history.replaceState(null, '', getViewURL()); });
        document.getElementById('filterPlate')!.addEventListener('input', () => { applyFilters(); history.replaceState(null, '', getViewURL()); });
        const grid = document.getElementById('grid');
        data.vehicles.forEach(vehicle => {
          const tile = document.createElement('a');
          tile.className = 'tile';
          tile.href = `/ocean/${vehicle.vin}`;
          const img = document.createElement('img');
          img.loading = 'lazy';
          const platesText = vehicle.license_plates.map(p => p.license_plate).join(', ');
          img.alt = `Vehicle ${platesText}`;
          const latestImage = vehicle.sightings?.slice().reverse().find(s => s.image)?.image;
          if (latestImage) {
            img.src = latestImage;
          } else {
            tile.classList.add('placeholder');
            img.src = '/fisker_ocean_placeholder.svg';
          }
          tile.appendChild(img);
          const info = document.createElement('div');
          info.className = 'tile-info';
          info.innerHTML = `<div class="plate">${platesText}</div>`;
          tile.appendChild(info);
          grid.appendChild(tile);
          allTiles.push(tile);
        });

        allVehicles = data.vehicles;
        initFromURL();
      })
      .catch(error => {
        document.getElementById('loading').textContent = 'Error loading data: ' + error.message;
      });

    function initFromURL() {
      const params = new URLSearchParams(window.location.search);
      (document.getElementById('filterStatus') as HTMLSelectElement).value = params.get('status') || 'all';
      const contributorEl = document.getElementById('filterContributor') as HTMLSelectElement;
      const contributor = params.get('contributor') || 'all';
      if ([...contributorEl.options].some(o => o.value === contributor)) contributorEl.value = contributor;
      const boroughEl = document.getElementById('filterBorough') as HTMLSelectElement;
      const borough = params.get('borough') || 'all';
      if ([...boroughEl.options].some(o => o.value === borough)) boroughEl.value = borough;
      (document.getElementById('filterPlate') as HTMLInputElement).value = params.get('plate') || '';
      applyFilters();
    }

    window.addEventListener('popstate', () => {
      const params = new URLSearchParams(window.location.search);
      (document.getElementById('filterStatus') as HTMLSelectElement).value = params.get('status') || 'all';
      const contributorEl = document.getElementById('filterContributor') as HTMLSelectElement;
      const contributor = params.get('contributor') || 'all';
      contributorEl.value = [...contributorEl.options].some(o => o.value === contributor) ? contributor : 'all';
      const boroughEl = document.getElementById('filterBorough') as HTMLSelectElement;
      const borough = params.get('borough') || 'all';
      boroughEl.value = [...boroughEl.options].some(o => o.value === borough) ? borough : 'all';
      (document.getElementById('filterPlate') as HTMLInputElement).value = params.get('plate') || '';
      applyFilters();
    });
  </script>
</Layout>

<style is:global>
  body {
    overflow-x: hidden;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(100px, 1fr));
  }

  .tile {
    aspect-ratio: 1;
    position: relative;
    overflow: hidden;
    background: #ffffff;
    cursor: pointer;
    transition: transform 0.2s ease;
    text-decoration: none;
    color: inherit;
    display: block;
  }

  .tile:hover {
    transform: scale(1.05);
    z-index: 10;
  }

  .tile img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .tile.placeholder img {
    width: 80%;
    height: 80%;
    object-fit: contain;
    opacity: 0.3;
  }

  .tile-info {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    background: linear-gradient(to top, rgba(0, 0, 0, 0.9) 0%, rgba(0, 0, 0, 0) 100%);
    color: white;
    padding: 20px 10px 10px;
    font-size: 11px;
    opacity: 0;
    transition: opacity 0.2s ease;
  }

  .tile:hover .tile-info {
    opacity: 1;
  }

  .plate {
    font-weight: 600;
    font-size: 13px;
    letter-spacing: 0.5px;
  }

  .form-group { margin-bottom: 16px; }
  .form-label { display: block; font-size: 14px; font-weight: 600; margin-bottom: 6px; color: #333; }
  .form-input, .form-select { width: 100%; padding: 10px 12px; border: 1px solid #ddd; border-radius: 6px; font-size: 14px; font-family: inherit; transition: border-color 0.2s; }
  .form-input:focus, .form-select:focus { outline: none; border-color: #333; }
  .form-input[type="file"] { padding: 8px; }
  .form-submit { width: 100%; padding: 12px; background: #333; color: white; border: none; border-radius: 6px; font-size: 14px; font-weight: 600; cursor: pointer; transition: background 0.2s; }
  .form-submit:hover:not(:disabled) { background: #000; }
  .form-submit:disabled { background: #999; cursor: not-allowed; }
  .form-hint { font-size: 12px; color: #666; margin-top: 4px; }
  .submit-status { margin-top: 16px; padding: 12px; border-radius: 6px; font-size: 14px; display: none; }
  .submit-status.success { background: #d4edda; color: #155724; border: 1px solid #c3e6cb; display: block; }
  .submit-status.error { background: #f8d7da; color: #721c24; border: 1px solid #f5c6cb; display: block; }
</style>
