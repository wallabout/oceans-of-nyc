---
import Layout from '../layouts/Layout.astro';

const boroughs = ['Manhattan', 'Brooklyn', 'Queens', 'Bronx', 'Staten Island', 'Outside NYC'];
---
<Layout title="Submit a Sighting — Oceans of NYC" description="Spotted a Fisker Ocean in NYC? Upload a photo with the license plate visible and add it to the Oceans of NYC catalog. No account needed." currentPage="submit">
  <main class="page page--medium">
    <div class="page-header">
      <h1>Submit a Sighting</h1>
      <p>
        Spotted a Fisker Ocean in NYC? Add your photos, one or many. We'll fill in each plate
        and borough where we can. Check them, fix anything that's off, and submit.
      </p>
    </div>

    <section class="bulk-setup">
      <div class="bulk-identity" id="bulkIdentity" hidden>
        <span>Submitting as <strong id="bulkIdentityName"></strong><span class="bulk-identity-email" id="bulkIdentityEmail"></span></span>
        <a id="bulkIdentityStats" hidden>Your stats</a>
        <button type="button" class="bulk-identity-switch" id="bulkIdentitySwitch">Not you?</button>
      </div>
      <div class="bulk-identity-fields" id="bulkIdentityFields">
        <div class="form-row">
          <div class="form-group">
            <label class="form-label" for="bulkName">Your Name</label>
            <input type="text" id="bulkName" class="form-input" placeholder="Enter your name" autocomplete="name" />
          </div>
          <div class="form-group">
            <label class="form-label" for="bulkEmail">Email (optional)</label>
            <input type="email" id="bulkEmail" class="form-input" placeholder="your@email.com" autocomplete="email" />
          </div>
        </div>
        <div class="form-hint">Same email = same contributor. Keeps your stats together.</div>
      </div>

      <label class="dropzone" id="dropzone" for="bulkFiles">
        <input type="file" id="bulkFiles" accept="image/*" multiple hidden />
        <strong>Add photos</strong>
        <span>Tap to choose, or drop them here. One photo or up to 50 at a time.</span>
      </label>
    </section>

    <section class="bulk-review" id="bulkReview" hidden>
      <div class="bulk-toolbar">
        <span class="bulk-count" id="bulkCount"></span>
        <label class="bulk-fill">
          Fill empty boroughs with
          <select id="bulkFillBorough" class="form-select form-select--small">
            <option value="">Choose…</option>
            {boroughs.map((b) => <option value={b}>{b}</option>)}
          </select>
        </label>
      </div>

      <ul class="bulk-list" id="bulkList"></ul>

      <button type="button" class="form-submit" id="bulkSubmit" disabled>Submit</button>
      <div class="submit-status" id="bulkStatus"></div>
    </section>

    <template id="bulkItemTemplate">
      <li class="bulk-item">
        <div class="bulk-thumb"><img alt="" /></div>
        <div class="bulk-fields">
          <div class="bulk-field">
            <label class="form-label">License Plate</label>
            <input type="text" class="form-input bulk-plate" placeholder="T123456C" autocapitalize="characters" spellcheck="false" />
            <div class="bulk-chips"></div>
          </div>
          <div class="bulk-field">
            <label class="form-label">Borough</label>
            <select class="form-select bulk-borough">
              <option value="">Select borough...</option>
              {boroughs.map((b) => <option value={b}>{b}</option>)}
            </select>
            <div class="form-hint bulk-borough-hint"></div>
          </div>
          <div class="bulk-item-status"></div>
          <div class="bulk-item-result"></div>
        </div>
        <button type="button" class="bulk-remove" aria-label="Remove photo">×</button>
      </li>
    </template>
  </main>

  <script>
    // Set PUBLIC_SUBMISSION_API to a `modal serve` URL to test against dev endpoints
    const API = import.meta.env.PUBLIC_SUBMISSION_API || 'https://wallabout--oceans-of-nyc-web-submission-webhook.modal.run';
    const MAX_FILES = 50;
    const MAX_EDGE = 1568; // the plate reader downsizes anything larger
    const EXIF_HEAD_BYTES = 256 * 1024; // where a JPEG keeps its EXIF block
    const CONCURRENCY = 3;
    const NAME_KEY = 'oon_bulk_name';
    const EMAIL_KEY = 'oon_bulk_email';
    const CONTRIBUTOR_KEY = 'oon_bulk_contributor_id';

    type Status = 'queued' | 'reading' | 'ready' | 'unsupported' | 'saving' | 'saved' | 'error';

    interface Item {
      id: number;
      file: File;
      status: Status;
      message: string;
      sightingId?: number;
      el: HTMLLIElement;
      plate: HTMLInputElement;
      borough: HTMLSelectElement;
    }

    const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
    const nameInput = $<HTMLInputElement>('bulkName');
    const emailInput = $<HTMLInputElement>('bulkEmail');
    const fileInput = $<HTMLInputElement>('bulkFiles');
    const dropzone = $<HTMLLabelElement>('dropzone');
    const review = $<HTMLElement>('bulkReview');
    const list = $<HTMLUListElement>('bulkList');
    const countLabel = $<HTMLSpanElement>('bulkCount');
    const fillBorough = $<HTMLSelectElement>('bulkFillBorough');
    const submitButton = $<HTMLButtonElement>('bulkSubmit');
    const statusBox = $<HTMLDivElement>('bulkStatus');
    const template = $<HTMLTemplateElement>('bulkItemTemplate');

    const items: Item[] = [];
    const queue: Item[] = [];
    let nextId = 1;
    let activeReads = 0;
    let submitting = false;

    function storageGet(key: string): string {
      try { return window.localStorage.getItem(key) || ''; } catch { return ''; }
    }
    function storageSet(key: string, value: string) {
      try { window.localStorage.setItem(key, value); } catch { /* private mode */ }
    }
    function storageRemove(key: string) {
      try { window.localStorage.removeItem(key); } catch { /* private mode */ }
    }

    // ---------- returning contributor ----------

    const identity = $<HTMLDivElement>('bulkIdentity');
    const identityFields = $<HTMLDivElement>('bulkIdentityFields');
    const identityStats = $<HTMLAnchorElement>('bulkIdentityStats');

    function statsUrl(contributorId: string | number): string {
      return `/contributor/${contributorId}`;
    }

    /** Swap the name/email fields for a one-line "Submitting as …" summary. */
    function showRemembered(name: string, email: string) {
      $<HTMLElement>('bulkIdentityName').textContent = name;
      $<HTMLElement>('bulkIdentityEmail').textContent = email ? ` (${email})` : '';
      const contributorId = storageGet(CONTRIBUTOR_KEY);
      identityStats.hidden = !contributorId;
      if (contributorId) identityStats.href = statsUrl(contributorId);
      identity.hidden = false;
      identityFields.hidden = true;
    }

    nameInput.value = storageGet(NAME_KEY);
    emailInput.value = storageGet(EMAIL_KEY);
    if (nameInput.value) showRemembered(nameInput.value, emailInput.value);

    $<HTMLButtonElement>('bulkIdentitySwitch').addEventListener('click', () => {
      // Forget this person on this device; the next submit remembers whoever it is.
      for (const key of [NAME_KEY, EMAIL_KEY, CONTRIBUTOR_KEY]) storageRemove(key);
      nameInput.value = '';
      emailInput.value = '';
      identity.hidden = true;
      identityFields.hidden = false;
      nameInput.focus();
    });

    // ---------- adding photos ----------

    function addFiles(files: FileList | File[]) {
      const images = Array.from(files).filter((f) => f.type.startsWith('image/') || /\.(heic|heif)$/i.test(f.name));
      const room = MAX_FILES - items.filter((i) => i.status !== 'saved').length;
      for (const file of images.slice(0, Math.max(0, room))) {
        const item = createItem(file);
        items.push(item);
        queue.push(item);
      }
      if (images.length > room) {
        showStatus('error', `Only ${MAX_FILES} photos at a time. Submit these, then add the rest.`);
      }
      review.hidden = items.length === 0;
      pumpQueue();
      refresh();
    }

    function createItem(file: File): Item {
      const el = (template.content.firstElementChild as HTMLLIElement).cloneNode(true) as HTMLLIElement;
      const item: Item = {
        id: nextId++,
        file,
        status: 'queued',
        message: 'Waiting…',
        el,
        plate: el.querySelector('.bulk-plate') as HTMLInputElement,
        borough: el.querySelector('.bulk-borough') as HTMLSelectElement,
      };
      const plateId = `plate-${item.id}`;
      const boroughId = `borough-${item.id}`;
      item.plate.id = plateId;
      item.borough.id = boroughId;
      const labels = el.querySelectorAll('label');
      labels[0].htmlFor = plateId;
      labels[1].htmlFor = boroughId;

      item.plate.addEventListener('input', () => {
        item.plate.value = item.plate.value.toUpperCase();
        markEdited(item);
      });
      item.borough.addEventListener('change', () => {
        (el.querySelector('.bulk-borough-hint') as HTMLElement).textContent = '';
        markEdited(item);
      });
      (el.querySelector('.bulk-remove') as HTMLButtonElement).addEventListener('click', () => removeItem(item));
      list.appendChild(el);
      return item;
    }

    function markEdited(item: Item) {
      if (item.status === 'error') setStatus(item, 'ready', '');
      refresh();
    }

    function removeItem(item: Item) {
      if (item.status === 'saving') return;
      const index = items.indexOf(item);
      if (index >= 0) items.splice(index, 1);
      const queued = queue.indexOf(item);
      if (queued >= 0) queue.splice(queued, 1);
      const img = item.el.querySelector('img') as HTMLImageElement;
      if (img.src) URL.revokeObjectURL(img.src);
      item.el.remove();
      review.hidden = items.length === 0;
      refresh();
    }

    // ---------- reading plates ----------

    function pumpQueue() {
      while (activeReads < CONCURRENCY && queue.length) {
        const item = queue.shift() as Item;
        activeReads++;
        readItem(item).finally(() => {
          activeReads--;
          pumpQueue();
          refresh();
        });
      }
    }

    async function downscale(file: File): Promise<Blob> {
      const bitmap = await createImageBitmap(file, { imageOrientation: 'from-image' });
      const scale = Math.min(1, MAX_EDGE / Math.max(bitmap.width, bitmap.height));
      const canvas = document.createElement('canvas');
      canvas.width = Math.round(bitmap.width * scale);
      canvas.height = Math.round(bitmap.height * scale);
      (canvas.getContext('2d') as CanvasRenderingContext2D).drawImage(bitmap, 0, 0, canvas.width, canvas.height);
      bitmap.close();
      return new Promise((resolve, reject) =>
        canvas.toBlob((blob) => (blob ? resolve(blob) : reject(new Error('encode failed'))), 'image/jpeg', 0.9),
      );
    }

    async function readItem(item: Item) {
      setStatus(item, 'reading', 'Reading plate…');

      let small: Blob;
      try {
        small = await downscale(item.file);
      } catch {
        setStatus(item, 'unsupported', "This browser can't open this photo. Try a JPEG, or use the single submit form.");
        return;
      }
      (item.el.querySelector('img') as HTMLImageElement).src = URL.createObjectURL(small);

      const body = new FormData();
      body.append('image', small, 'photo.jpg');
      body.append('exif_head', item.file.slice(0, EXIF_HEAD_BYTES), 'head.bin');

      try {
        const response = await fetch(`${API}/extract`, { method: 'POST', body });
        const result = await response.json();
        if (!result.success) {
          setStatus(item, 'ready', result.message || "Couldn't read this one. Enter the plate below.");
          return;
        }
        applySuggestions(item, result);
      } catch {
        setStatus(item, 'ready', "Couldn't read this one. Enter the plate below.");
      }
    }

    function applySuggestions(item: Item, result: {
      suggestions: { plate: string; distance: number }[];
      borough: string | null;
      has_gps: boolean;
    }) {
      const plates = result.suggestions.map((s) => s.plate);
      // An exact read is almost always right; only offer alternatives for near misses
      const exact = result.suggestions.length > 0 && result.suggestions[0].distance === 0;
      // Don't overwrite anything the contributor typed while we were reading
      if (!item.plate.value && plates.length) item.plate.value = plates[0];

      const chips = item.el.querySelector('.bulk-chips') as HTMLElement;
      chips.replaceChildren();
      if (plates.length > 1 && !exact) {
        for (const plate of plates) {
          const chip = document.createElement('button');
          chip.type = 'button';
          chip.className = 'bulk-chip';
          chip.textContent = plate;
          chip.addEventListener('click', () => {
            item.plate.value = plate;
            markEdited(item);
          });
          chips.appendChild(chip);
        }
      }

      const hint = item.el.querySelector('.bulk-borough-hint') as HTMLElement;
      if (!item.borough.value && result.borough) {
        item.borough.value = result.borough;
        hint.textContent = 'From photo location';
      } else if (!result.has_gps) {
        hint.textContent = 'No location in this photo';
      }

      let message = "Couldn't read the plate. Enter it below.";
      if (exact) message = 'Plate filled in. Check it matches.';
      else if (plates.length > 1) message = 'Best guess filled in. Tap another if it’s wrong.';
      else if (plates.length) message = 'Best guess filled in. Check it matches.';
      setStatus(item, 'ready', message);
    }

    // ---------- status & toolbar ----------

    function setStatus(item: Item, status: Status, message: string) {
      item.status = status;
      item.message = message;
      item.el.dataset.status = status;
      (item.el.querySelector('.bulk-item-status') as HTMLElement).textContent = message;
      const locked = status === 'saving' || status === 'saved' || status === 'unsupported';
      item.plate.disabled = locked;
      item.borough.disabled = locked;
      item.el.querySelectorAll<HTMLButtonElement>('.bulk-chip').forEach((chip) => (chip.disabled = locked));
    }

    function pending(): Item[] {
      return items.filter((i) => i.status === 'ready' || i.status === 'error');
    }

    function refresh() {
      const reading = items.filter((i) => i.status === 'queued' || i.status === 'reading').length;
      const saved = items.filter((i) => i.status === 'saved').length;
      const ready = pending().length;
      const parts = [`${items.length} photo${items.length === 1 ? '' : 's'}`];
      if (reading) parts.push(`${reading} reading`);
      if (saved) parts.push(`${saved} saved`);
      countLabel.textContent = parts.join(' · ');

      submitButton.disabled = submitting || ready === 0;
      submitButton.textContent = submitting
        ? 'Submitting…'
        : ready ? `Submit ${ready} sighting${ready === 1 ? '' : 's'}` : 'Submit';
    }

    function showStatus(kind: 'success' | 'error' | '', text: string) {
      statusBox.className = kind ? `submit-status ${kind}` : 'submit-status';
      statusBox.textContent = text;
    }

    fillBorough.addEventListener('change', () => {
      const value = fillBorough.value;
      if (!value) return;
      for (const item of items) {
        if (!item.borough.disabled && !item.borough.value) {
          item.borough.value = value;
          markEdited(item);
        }
      }
      fillBorough.value = '';
    });

    fileInput.addEventListener('change', () => {
      if (fileInput.files) addFiles(fileInput.files);
      fileInput.value = '';
    });
    dropzone.addEventListener('dragover', (e) => { e.preventDefault(); dropzone.classList.add('dragging'); });
    dropzone.addEventListener('dragleave', () => dropzone.classList.remove('dragging'));
    dropzone.addEventListener('drop', (e) => {
      e.preventDefault();
      dropzone.classList.remove('dragging');
      if (e.dataTransfer?.files) addFiles(e.dataTransfer.files);
    });

    // ---------- confirmation ----------

    interface SubmitResult {
      message?: string;
      sighting_id: number;
      contributor_id?: number;
      stats?: {
        vehicle_sighting_num: number;
        total_sightings: number;
        contributor_sighting_num: number;
        contributor_vehicle_sighting_num: number;
      };
      new_badges?: { display_name: string; description: string }[];
    }

    function ordinal(n: number): string {
      if (n % 100 >= 10 && n % 100 <= 20) return n + 'th';
      return n + (({ 1: 'st', 2: 'nd', 3: 'rd' } as Record<number, string>)[n % 10] || 'th');
    }

    /** Where this sighting landed: vehicle count, overall count, and new badges. */
    function buildConfirmation(result: SubmitResult): DocumentFragment {
      const fragment = document.createDocumentFragment();
      if (result.stats) {
        const stats = result.stats;
        const lines = [
          `the ${ordinal(stats.vehicle_sighting_num)} sighting of this vehicle`,
          `the ${ordinal(stats.total_sightings)} Ocean sighting overall`,
        ];
        if (stats.contributor_vehicle_sighting_num > 1) {
          lines.push(`your ${ordinal(stats.contributor_vehicle_sighting_num)} time spotting this Ocean`);
        }
        lines.push(`your ${ordinal(stats.contributor_sighting_num)} contribution`);
        const list = document.createElement('ul');
        list.className = 'stats-list';
        for (const line of lines) {
          const li = document.createElement('li');
          li.textContent = line;
          list.appendChild(li);
        }
        fragment.appendChild(list);
      }
      for (const badge of result.new_badges || []) {
        const div = document.createElement('div');
        div.className = 'badge-line';
        const name = document.createElement('strong');
        name.textContent = `NEW BADGE: ${badge.display_name}`;
        div.append(name, ` ${badge.description}`);
        fragment.appendChild(div);
      }
      return fragment;
    }

    /** "See your stats" link to the contributor page, which goes live on the next site rebuild. */
    function buildStatsLink(saved: SubmitResult[]): HTMLElement | null {
      const contributorId = saved.find((r) => r.contributor_id != null)?.contributor_id;
      if (contributorId == null) return null;
      const isNew = saved.some((r) => r.stats?.contributor_sighting_num === 1);
      const div = document.createElement('div');
      div.className = 'stats-link';
      const link = document.createElement('a');
      link.href = statsUrl(contributorId);
      link.textContent = 'See your stats →';
      div.append(link, isNew ? ' Your page goes live in a few minutes.' : ' Updates in a few minutes.');
      return div;
    }

    // ---------- submitting ----------

    async function submitItem(item: Item, name: string, email: string): Promise<SubmitResult | null> {
      setStatus(item, 'saving', 'Saving…');
      const body = new FormData();
      body.append('image', item.file);
      body.append('license_plate', item.plate.value.trim());
      body.append('borough', item.borough.value);
      body.append('contributor_name', name);
      if (email) body.append('email', email);
      body.append('defer_hooks', 'true');

      try {
        const response = await fetch(`${API}/submit`, { method: 'POST', body });
        const result = await response.json();
        if (result.success) {
          setStatus(item, 'saved', result.message || 'Saved');
          item.sightingId = result.sighting_id;
          (item.el.querySelector('.bulk-item-result') as HTMLElement).replaceChildren(buildConfirmation(result));
          return result;
        }
        if (result.error === 'duplicate') {
          setStatus(item, 'saved', 'Already submitted earlier. Skipped.');
          return null;
        }
        setStatus(item, 'error', result.message || 'Something went wrong. Check and try again.');
      } catch {
        setStatus(item, 'error', 'Network error. Try again.');
      }
      return null;
    }

    submitButton.addEventListener('click', async () => {
      const name = nameInput.value.trim();
      const email = emailInput.value.trim();
      if (!name) {
        showStatus('error', 'Add your name so we can credit you.');
        nameInput.focus();
        return;
      }

      const toSubmit: Item[] = [];
      for (const item of pending()) {
        if (!item.plate.value.trim() || !item.borough.value) {
          setStatus(item, 'error', !item.plate.value.trim() ? 'Enter the plate.' : 'Pick a borough.');
        } else {
          toSubmit.push(item);
        }
      }
      if (!toSubmit.length) {
        showStatus('error', 'Every photo needs a plate and a borough.');
        refresh();
        return;
      }

      storageSet(NAME_KEY, name);
      storageSet(EMAIL_KEY, email);
      submitting = true;
      showStatus('', '');
      refresh();

      const saved: SubmitResult[] = [];
      // One at a time, so badges and sighting counts are awarded in order
      for (const item of toSubmit) {
        const result = await submitItem(item, name, email);
        if (result) saved.push(result);
        refresh();
      }
      const savedIds = saved.map((r) => r.sighting_id);
      const contributorId = saved.find((r) => r.contributor_id != null)?.contributor_id;
      if (contributorId != null) storageSet(CONTRIBUTOR_KEY, String(contributorId));

      if (savedIds.length) {
        // Rebuild the site, check the posting queue and email the admin once.
        // keepalive lets this finish even if the contributor leaves the page.
        fetch(`${API}/submit-batch-complete`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ sighting_ids: savedIds, contributor_name: name }),
          keepalive: true,
        }).catch(() => { /* hooks also run on the next submission */ });
      }

      submitting = false;
      refresh();
      const failed = items.filter((i) => i.status === 'error').length;
      if (failed) {
        showStatus('error', `Saved ${savedIds.length}. ${failed} need${failed === 1 ? 's' : ''} a fix. See the highlighted photos, then submit again.`);
      } else if (saved.length === 1) {
        showStatus('success', '');
        const heading = document.createElement('strong');
        heading.textContent = 'Sighting logged! Thanks!!';
        statusBox.append(heading, buildConfirmation(saved[0]));
      } else if (saved.length) {
        showStatus('success', `Saved ${saved.length} sightings. Thanks!! See each photo for where it landed. They'll appear on the site in a few minutes.`);
      } else {
        showStatus('success', 'Those photos were already submitted. Nothing new to save.');
      }
      const statsLink = buildStatsLink(saved);
      if (statsLink && !failed) statusBox.append(statsLink);
    });
  </script>
</Layout>

<style>
  .bulk-setup {
    display: flex;
    flex-direction: column;
    gap: 12px;
    max-width: 640px;
  }

  .form-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
  }

  .form-group {
    display: flex;
    flex-direction: column;
  }

  .form-label {
    font-size: 13px;
    font-weight: 600;
    margin-bottom: 6px;
    color: #333;
  }

  .form-input,
  .form-select {
    width: 100%;
    padding: 10px 12px;
    border: 1px solid #ddd;
    border-radius: 6px;
    font-size: 16px; /* 16px stops iOS zooming into the field */
    font-family: inherit;
    color: #333;
    background: #fff;
  }

  .form-input:focus,
  .form-select:focus {
    outline: none;
    border-color: #333;
  }

  .form-input:disabled,
  .form-select:disabled {
    background: var(--color-bg-muted);
    color: var(--color-text-muted);
  }

  .form-select--small {
    width: auto;
    padding: 6px 8px;
    font-size: 14px;
  }

  .form-hint {
    font-size: 12px;
    color: #888;
    margin-top: 4px;
  }

  .dropzone {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
    padding: 32px 16px;
    margin-top: 8px;
    border: 2px dashed #ccc;
    border-radius: 8px;
    background: var(--color-bg-subtle);
    cursor: pointer;
    text-align: center;
    font-size: 14px;
    color: var(--color-text-muted);
  }

  .dropzone strong {
    font-size: 16px;
    color: var(--color-text);
  }

  .dropzone:hover,
  .dropzone.dragging {
    border-color: #333;
    background: #fff;
  }

  .bulk-review {
    margin-top: 32px;
  }

  .bulk-toolbar {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
    margin-bottom: 12px;
    font-size: 14px;
  }

  .bulk-count {
    font-weight: 600;
  }

  .bulk-fill {
    display: flex;
    align-items: center;
    gap: 8px;
    color: var(--color-text-muted);
  }

  .bulk-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .bulk-item {
    position: relative;
    display: grid;
    grid-template-columns: 160px 1fr;
    gap: 16px;
    padding: 12px;
    border: 1px solid var(--color-border);
    border-radius: 8px;
    background: #fff;
  }

