---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Tag Random Photos — Oceans of NYC" currentPage="tags">
  <main class="page page--narrow random-page">
    <div class="page-header">
      <h1>Tag a random photo</h1>
      <p>
        Most of our photos have never been looked at twice. Tag what you see and skip what you
        don't — it's anonymous, and every tag helps surface the rare colors and the great shots.
      </p>
    </div>

    <div class="loading" id="loading">Loading a photo...</div>

    <div class="random-card" id="randomCard" hidden>
      <div class="random-card__image-wrap">
        <img class="random-card__image" id="randomImage" alt="A Fisker Ocean sighting" />
      </div>
      <div class="random-card__body">
        <div class="random-card__plate" id="randomPlate"></div>
        <div class="random-card__meta" id="randomMeta"></div>
        <div class="random-card__tags" id="randomTags"></div>
      </div>
      <div class="random-card__picker" id="randomPicker"></div>
      <div class="random-card__actions">
        <button type="button" class="random-next" id="randomNext">Next photo →</button>
        <span class="random-progress" id="randomProgress"></span>
      </div>
    </div>

    <p class="random-empty" id="randomEmpty" hidden>No photos to tag right now. Check back soon.</p>
  </main>

  <script>
    import { loadTagData, countsFor, renderTagChips, buildTagPicker, escapeHTML, getMyTags, EMPTY_TAG_DATA } from '../lib/tags';

    let tagData = EMPTY_TAG_DATA;
    let candidates = [];
    let current = null;
    let tagged = 0;

    const DATA_URL = window.location.hostname === 'localhost' ? '/oceans.json' : 'https://cdn.oceansofnyc.com/web/oceans.json';

    Promise.all([fetch(DATA_URL).then(r => r.json()), loadTagData()])
      .then(([data, tags]) => {
        tagData = tags;

        const withPhotos = [];
        data.vehicles.forEach(vehicle => {
          vehicle.sightings?.forEach(sighting => {
            if (sighting.image && sighting.id != null) withPhotos.push({ sighting, vehicle });
          });
        });

        // Bias toward photos nobody has looked at yet — that's the whole point of
        // this view. Once every photo has a tag, fall back to the full set.
        const untouched = withPhotos.filter(({ sighting }) =>
          !tagData.sighting_tags[String(sighting.id)] && getMyTags(sighting.id).length === 0
        );
        candidates = untouched.length > 0 ? untouched : withPhotos;
        shuffle(candidates);

        document.getElementById('loading').style.display = 'none';
        if (candidates.length === 0) {
          document.getElementById('randomEmpty').hidden = false;
          return;
        }
        document.getElementById('randomCard').hidden = false;
        showNext();
      })
      .catch(error => {
        document.getElementById('loading').textContent = 'Error loading data: ' + error.message;
      });

    function shuffle(items) {
      for (let i = items.length - 1; i > 0; i--) {
        const j = Math.floor(Math.random() * (i + 1));
        [items[i], items[j]] = [items[j], items[i]];
      }
    }

    function showNext() {
      if (candidates.length === 0) {
        document.getElementById('randomCard').hidden = true;
        document.getElementById('randomEmpty').hidden = false;
        return;
      }
      current = candidates.pop();
      render(current);
    }

    function renderChips() {
      const { sighting } = current;
      document.getElementById('randomTags').innerHTML = renderTagChips(countsFor(tagData, sighting.id), tagData.tag_definitions);
    }

    function render({ sighting, vehicle }) {
      const platesText = vehicle.license_plates.map(p => p.license_plate).join(', ');
      const image = document.getElementById('randomImage') as HTMLImageElement;
      image.src = sighting.image;
      image.alt = `Fisker Ocean ${platesText}`;

      document.getElementById('randomPlate').innerHTML =
        `<a href="/ocean/${encodeURIComponent(vehicle.vin)}">${escapeHTML(platesText)}</a>`;

      const date = new Date(sighting.timestamp);
      const formattedDate = date.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric', timeZone: 'America/New_York' });
      const metaParts = [
        sighting.contributor ? `<span>from ${escapeHTML(sighting.contributor)}</span>` : '',
        sighting.borough ? `<span>in ${escapeHTML(sighting.borough)}</span>` : '',
        `<span>on ${formattedDate}</span>`,
      ].filter(Boolean).join('');
      document.getElementById('randomMeta').innerHTML = metaParts;

      renderChips();

      const picker = document.getElementById('randomPicker');
      picker.innerHTML = '';
      picker.appendChild(buildTagPicker(sighting.id, tagData.tag_definitions, () => {
        tagged++;
        updateProgress();
        renderChips();
      }));

      updateProgress();
    }

    function updateProgress() {
      const label = tagged === 0 ? '' : `${tagged} tag${tagged === 1 ? '' : 's'} this session — thank you!`;
      document.getElementById('randomProgress').textContent = label;
    }

    document.getElementById('randomNext').addEventListener('click', showNext);

    document.addEventListener('keydown', (event) => {
      if (event.key === 'ArrowRight' && !document.getElementById('randomCard').hidden) showNext();
    });
  </script>
</Layout>

<style>
  .random-page {
    padding-bottom: 60px;
  }

  .random-card {
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    overflow: hidden;
    background: var(--color-bg);
  }

  .random-card__image-wrap {
    background: var(--color-bg-muted);
  }

  .random-card__image {
    width: 100%;
    max-height: 460px;
    object-fit: contain;
    display: block;
  }

  .random-card__body {
    padding: var(--space-4) var(--space-5) 0;
  }

  .random-card__plate {
    font-size: 20px;
    font-weight: 700;
    letter-spacing: 1px;
    color: var(--color-text);
  }

  .random-card__plate a {
    text-decoration: none;
  }

  .random-card__meta {
    display: flex;
    gap: 6px;
    flex-wrap: wrap;
    font-size: 13px;
    color: var(--color-text-muted);
    margin-top: var(--space-1);
  }

  .random-card__picker {
    padding: var(--space-4) var(--space-5);
  }

  .random-card__actions {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding: 0 var(--space-5) var(--space-5);
  }

  .random-next {
    padding: 10px var(--space-5);
    background: #111;
    color: white;
    border: none;
    border-radius: var(--radius-md);
    font-family: inherit;
    font-size: 14px;
    font-weight: 600;
    cursor: pointer;
  }

  .random-next:hover {
    background: #000;
  }

  .random-progress {
    font-size: 13px;
    color: var(--color-text-subtle);
  }

  .random-empty {
    font-size: 14px;
    color: var(--color-text-muted);
  }
</style>
