---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Tag Random Photos — Oceans of NYC" currentPage="tags">
  <main class="random-page">
    <div class="page-header">
      <h1>Tag a random photo</h1>
      <p>
        Most of our photos have never been looked at twice. Tag what you see and skip what you
        don't — it's anonymous, and every tag helps surface the rare colors and the great shots.
      </p>
    </div>

    <div class="loading" id="loading">Loading a photo...</div>

    <div id="randomCard"></div>

    <div class="random-actions" id="randomActions" hidden>
      <button type="button" class="random-next" id="randomNext">Next photo →</button>
      <span class="random-progress" id="randomProgress"></span>
    </div>

    <p class="random-empty" id="randomEmpty" hidden>No photos to tag right now. Check back soon.</p>
  </main>

  <script>
    import { loadTagData, countsFor, renderTagChips, buildTagPicker, getMyTags, EMPTY_TAG_DATA } from '../lib/tags';
    import { buildFeedCard } from '../lib/feedCard';

    let tagData = EMPTY_TAG_DATA;
    let badgeDefsMap = new Map();
    let candidates = [];
    let current = null;
    let tagged = 0;

    const DATA_URL = window.location.hostname === 'localhost' ? '/oceans.json' : 'https://cdn.oceansofnyc.com/web/oceans.json';

    Promise.all([fetch(DATA_URL).then(r => r.json()), loadTagData()])
      .then(([data, tags]) => {
        tagData = tags;
        badgeDefsMap = new Map((data.badge_definitions || []).map(b => [b.name, b]));

        const withPhotos = [];
        data.vehicles.forEach(vehicle => {
          vehicle.sightings?.forEach(sighting => {
            if (sighting.image && sighting.id != null) withPhotos.push({ sighting, vehicle });
          });
        });

        // Bias toward photos nobody has looked at yet — that's the whole point of
        // this view. Once every photo has a tag, fall back to the full set.
        const untouched = withPhotos.filter(({ sighting }) =>
          !tagData.sighting_tags[String(sighting.id)] && getMyTags(sighting.id).length === 0
        );
        candidates = untouched.length > 0 ? untouched : withPhotos;
        shuffle(candidates);

        document.getElementById('loading').style.display = 'none';
        if (candidates.length === 0) {
          document.getElementById('randomEmpty').hidden = false;
          return;
        }
        document.getElementById('randomActions').hidden = false;
        showNext();
      })
      .catch(error => {
        document.getElementById('loading').textContent = 'Error loading data: ' + error.message;
      });

    function shuffle(items) {
      for (let i = items.length - 1; i > 0; i--) {
        const j = Math.floor(Math.random() * (i + 1));
        [items[i], items[j]] = [items[j], items[i]];
      }
    }

    function showNext() {
      if (candidates.length === 0) {
        document.getElementById('randomCard').innerHTML = '';
        document.getElementById('randomActions').hidden = true;
        document.getElementById('randomEmpty').hidden = false;
        return;
      }
      current = candidates.pop();
      render(current);
    }

    function renderChips() {
      const container = document.querySelector<HTMLElement>(`[data-tags-for="${current.sighting.id}"]`);
      if (container) {
        container.innerHTML = renderTagChips(countsFor(tagData, current.sighting.id), tagData.tag_definitions);
      }
    }

    function render({ sighting, vehicle }) {
      // Same card as the feed, minus the tag button: the picker is right below,
      // so a modal would just be an extra click on a page built for tagging.
      const card = buildFeedCard(sighting, vehicle, {
        badgeDefs: badgeDefsMap,
        tagging: false,
        cardLink: false,
      });

      const body = card.querySelector('.feed-card-body');
      const chips = document.createElement('div');
      chips.className = 'feed-card-tagbar';
      chips.innerHTML = `<div class="feed-card-tags" data-tags-for="${sighting.id}"></div>`;
      body.appendChild(chips);

      const picker = document.createElement('div');
      picker.className = 'random-picker';
      picker.appendChild(buildTagPicker(sighting.id, tagData.tag_definitions, () => {
        tagged++;
        updateProgress();
        renderChips();
      }));
      card.appendChild(picker);

      const host = document.getElementById('randomCard');
      host.innerHTML = '';
      host.appendChild(card);

      renderChips();
      updateProgress();
    }

    function updateProgress() {
      const label = tagged === 0 ? '' : `${tagged} tag${tagged === 1 ? '' : 's'} this session — thank you!`;
      document.getElementById('randomProgress').textContent = label;
    }

    document.getElementById('randomNext').addEventListener('click', showNext);

    document.addEventListener('keydown', (event) => {
      if (event.key === 'ArrowRight' && !document.getElementById('randomActions').hidden) showNext();
    });
  </script>
</Layout>

<style>
  .random-page {
    max-width: 760px;
    margin: 0 auto;
    padding: var(--space-5) var(--space-5) 60px;
  }

  .random-page .page-header {
    margin-bottom: var(--space-5);
  }

  .random-actions {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    margin-top: var(--space-4);
  }

  .random-next {
    padding: 10px var(--space-5);
    background: #111;
    color: white;
    border: none;
    border-radius: var(--radius-md);
    font-family: inherit;
    font-size: 14px;
    font-weight: 600;
    cursor: pointer;
  }

  .random-next:hover {
    background: #000;
  }

  .random-progress {
    font-size: 13px;
    color: var(--color-text-subtle);
  }

  .random-empty {
    font-size: 14px;
    color: var(--color-text-muted);
  }

  @media (max-width: 768px) {
    .random-page {
      padding: var(--space-4) var(--space-3) 60px;
    }
  }
</style>

<style is:global>
  /* The picker is appended to the card by the client script, and Astro's scoped
     styles only reach elements that exist in the template — so this has to be
     global or it silently does nothing. */
  .random-picker {
    padding: var(--space-4) var(--space-5) var(--space-5);
    border-top: 1px solid var(--color-border-subtle);
    position: relative;
    z-index: 2;
    background: var(--color-bg);
  }
</style>
